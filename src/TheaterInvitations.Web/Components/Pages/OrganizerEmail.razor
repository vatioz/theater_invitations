@page "/organizer/email"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject EmailCampaignService EmailCampaignService
@inject OrganizerService OrganizerService

<PageTitle>Email campaigns</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Organizer</p><h1>Email campaigns</h1><OrganizerNavigation /></header>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
    <section class="rsvp-card">
        <h2>Campaigns</h2>
        <p>Campaign preparation freezes a recipient snapshot for review. Sending is a manually confirmed server-side operation.</p>
        @if (campaigns.Count == 0) { <p>No email campaigns have been prepared.</p> }
        else { <div class="saved-draft-list">@foreach (var campaign in campaigns) { <div><a class="button-secondary" href="/organizer/email/@campaign.Id">Review</a><span><strong>@FormatCampaignType(campaign.Type) for @campaign.BatchName</strong><br /><small>@FormatCampaignState(campaign.State), template v@campaign.TemplateVersionNumber, @campaign.RecipientCount recipients, prepared @campaign.CreatedAtUtc.ToString("u")</small></span></div> }</div> }
    </section>
    <AuthorizeView Roles="Operator,ElevatedOperator" Context="emailAuth"><Authorized>
        <section class="rsvp-card"><h2>Create campaign</h2><EditForm Model="campaignInput" OnValidSubmit="PrepareCampaignAsync" FormName="email-campaign" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>Campaign type <InputSelect @bind-Value="campaignInput.Type"><option value="@EmailCampaignType.InitialInvitation">Initial invitation</option><option value="@EmailCampaignType.Reminder">Reminder</option></InputSelect></label><label>Committed batch <InputSelect @bind-Value="campaignInput.BatchId"><option value="">Select a batch</option>@foreach (var batch in batches.Where(x => x.State == InvitationBatchState.Committed)) { <option value="@batch.Id">@batch.Name</option> }</InputSelect></label><label>Approved template <InputSelect @bind-Value="campaignInput.TemplateId"><option value="">Select a template</option>@foreach (var template in templates.Where(x => x.Type == RequiredTemplateType && x.State == EmailTemplateState.Approved)) { <option value="@template.Id">v@template.VersionNumber: @template.Subject</option> }</InputSelect></label><button type="submit">Prepare campaign for review</button></EditForm></section>
        <section class="rsvp-card"><h2>Test send</h2><p class="form-help">Sends the approved template to a controlled address without creating campaign or party dispatch records.</p><EditForm Model="testSendInput" OnValidSubmit="SendTestAsync" FormName="email-test-send" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>Approved template <InputSelect @bind-Value="testSendInput.TemplateId"><option value="">Select a template</option>@foreach (var template in templates.Where(x => x.State == EmailTemplateState.Approved)) { <option value="@template.Id">@FormatTemplateType(template.Type) v@template.VersionNumber: @template.Subject</option> }</InputSelect></label><label>Test recipient <InputText @bind-Value="testSendInput.RecipientEmail" /></label><button type="submit">Send test email</button></EditForm></section>
        <section class="rsvp-card"><h2>Templates</h2><p class="form-help">Supported placeholders: <code>{{guest_name}}</code>, <code>{{allocation}}</code>, <code>{{event_name}}</code>, <code>{{event_date}}</code>, <code>{{doors_time}}</code>, <code>{{start_time}}</code>, <code>{{venue_name}}</code>, <code>{{venue_address}}</code>, <code>{{deadline}}</code>, <code>{{rsvp_url}}</code>, and <code>{{support_email}}</code>.</p><EditForm Model="templateInput" OnValidSubmit="CreateTemplateAsync" FormName="email-template" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>Type <InputSelect @bind-Value="templateInput.Type"><option value="@EmailTemplateType.InitialInvitation">Initial invitation</option><option value="@EmailTemplateType.Reminder">Reminder</option></InputSelect></label><label>Subject <InputText @bind-Value="templateInput.Subject" /></label><label>HTML body <InputTextArea @bind-Value="templateInput.HtmlBody" /></label><label>Plain-text body <InputTextArea @bind-Value="templateInput.PlainTextBody" /></label><button type="submit">Create draft template</button></EditForm>@if (templates.Count > 0) { <div class="saved-draft-list">@foreach (var template in templates) { <div><span><strong>@FormatTemplateType(template.Type) v@template.VersionNumber</strong><br /><small>@template.State: @template.Subject</small></span>@if (template.State == EmailTemplateState.Draft) { <button @onclick="(() => ApproveTemplateAsync(template))">Approve template</button> }</div> }</div> }</section>
    </Authorized></AuthorizeView>
</main>
@code {
    private IReadOnlyList<EmailCampaignSummary> campaigns = Array.Empty<EmailCampaignSummary>(); private IReadOnlyList<EmailTemplateSummary> templates = Array.Empty<EmailTemplateSummary>(); private IReadOnlyList<OrganizerBatch> batches = Array.Empty<OrganizerBatch>(); private readonly CampaignInput campaignInput = new(); private readonly TemplateInput templateInput = new(); private readonly TestSendInput testSendInput = new(); private string? error;
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task RefreshAsync() { campaigns = await EmailCampaignService.GetCampaignsAsync(); templates = await EmailCampaignService.GetTemplatesAsync(); batches = await OrganizerService.GetBatchesAsync(); }
    private async Task CreateTemplateAsync() { try { await EmailCampaignService.CreateTemplateAsync(new EmailTemplateInput(templateInput.Type, templateInput.Subject, templateInput.HtmlBody, templateInput.PlainTextBody)); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is ArgumentException or InvalidOperationException) { error = exception.Message; } }
    private async Task ApproveTemplateAsync(EmailTemplateSummary template) { try { await EmailCampaignService.ApproveTemplateAsync(template.Id, template.Version); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is StaleDataException or InvalidOperationException) { error = exception.Message; await RefreshAsync(); } }
    private async Task PrepareCampaignAsync() { if (campaignInput.BatchId is null || campaignInput.TemplateId is null) { error = "Select a committed batch and an approved template."; return; } try { if (campaignInput.Type == EmailCampaignType.InitialInvitation) await EmailCampaignService.PrepareInitialCampaignAsync(campaignInput.BatchId.Value, campaignInput.TemplateId.Value); else await EmailCampaignService.PrepareReminderCampaignAsync(campaignInput.BatchId.Value, campaignInput.TemplateId.Value); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; } }
    private async Task SendTestAsync() { if (testSendInput.TemplateId is null) { error = "Select an approved template for the test send."; return; } try { await EmailCampaignService.SendTestAsync(testSendInput.TemplateId.Value, testSendInput.RecipientEmail); error = "Test email accepted by the provider."; } catch (Exception exception) when (exception is ArgumentException or InvalidOperationException) { error = exception.Message; } }
    private EmailTemplateType RequiredTemplateType => campaignInput.Type == EmailCampaignType.Reminder ? EmailTemplateType.Reminder : EmailTemplateType.InitialInvitation;
    private sealed class CampaignInput { public EmailCampaignType Type { get; set; } = EmailCampaignType.InitialInvitation; public Guid? BatchId { get; set; } public Guid? TemplateId { get; set; } }
    private sealed class TestSendInput { public Guid? TemplateId { get; set; } [Required, EmailAddress] public string RecipientEmail { get; set; } = string.Empty; }
    private sealed class TemplateInput { public EmailTemplateType Type { get; set; } = EmailTemplateType.InitialInvitation; [Required] public string Subject { get; set; } = string.Empty; [Required] public string HtmlBody { get; set; } = string.Empty; [Required] public string PlainTextBody { get; set; } = string.Empty; }
    private static string FormatCampaignType(EmailCampaignType type) => type == EmailCampaignType.InitialInvitation ? "Initial invitation" : type.ToString();
    private static string FormatTemplateType(EmailTemplateType type) => type == EmailTemplateType.InitialInvitation ? "Initial invitation" : type.ToString();
    private static string FormatCampaignState(EmailCampaignState state) => state == EmailCampaignState.ReadyForReview ? "Ready for review" : state.ToString();
}
