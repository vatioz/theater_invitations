@page "/organizer/email"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject EmailCampaignService EmailCampaignService
@inject OrganizerService OrganizerService

<PageTitle>Email campaigns</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Organizer</p><h1>Email campaigns</h1><OrganizerNavigation /></header>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
    <section class="rsvp-card">
        <h2>Campaigns</h2>
        <p>Campaign preparation creates a durable recipient snapshot. Sending is not yet enabled in this first Phase 4 slice.</p>
        @if (campaigns.Count == 0) { <p>No email campaigns have been prepared.</p> }
        else { <div class="saved-draft-list">@foreach (var campaign in campaigns) { <div><span><strong>@campaign.Type for @campaign.BatchName</strong><br /><small>@campaign.State, template v@campaign.TemplateVersionNumber, @campaign.RecipientCount recipients, prepared @campaign.CreatedAtUtc.ToString("u")</small></span></div> }</div> }
    </section>
    <AuthorizeView Roles="Operator,ElevatedOperator" Context="emailAuth"><Authorized>
        <section class="rsvp-card"><h2>Create initial invitation campaign</h2><EditForm Model="campaignInput" OnValidSubmit="PrepareCampaignAsync" FormName="email-campaign" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>Committed batch <InputSelect @bind-Value="campaignInput.BatchId"><option value="">Select a batch</option>@foreach (var batch in batches.Where(x => x.State == InvitationBatchState.Committed)) { <option value="@batch.Id">@batch.Name</option> }</InputSelect></label><label>Approved template <InputSelect @bind-Value="campaignInput.TemplateId"><option value="">Select a template</option>@foreach (var template in templates.Where(x => x.Type == EmailTemplateType.InitialInvitation && x.State == EmailTemplateState.Approved)) { <option value="@template.Id">v@template.VersionNumber: @template.Subject</option> }</InputSelect></label><button type="submit">Prepare campaign for review</button></EditForm></section>
        <section class="rsvp-card"><h2>Templates</h2><EditForm Model="templateInput" OnValidSubmit="CreateTemplateAsync" FormName="email-template" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>Type <InputSelect @bind-Value="templateInput.Type"><option value="@EmailTemplateType.InitialInvitation">Initial invitation</option><option value="@EmailTemplateType.Reminder">Reminder</option></InputSelect></label><label>Subject <InputText @bind-Value="templateInput.Subject" /></label><label>HTML body <InputTextArea @bind-Value="templateInput.HtmlBody" /></label><label>Plain-text body <InputTextArea @bind-Value="templateInput.PlainTextBody" /></label><button type="submit">Create draft template</button></EditForm>@if (templates.Count > 0) { <div class="saved-draft-list">@foreach (var template in templates) { <div><span><strong>@template.Type v@template.VersionNumber</strong><br /><small>@template.State: @template.Subject</small></span>@if (template.State == EmailTemplateState.Draft) { <button @onclick="(() => ApproveTemplateAsync(template))">Approve template</button> }</div> }</div> }</section>
    </Authorized></AuthorizeView>
</main>
@code {
    private IReadOnlyList<EmailCampaignSummary> campaigns = Array.Empty<EmailCampaignSummary>(); private IReadOnlyList<EmailTemplateSummary> templates = Array.Empty<EmailTemplateSummary>(); private IReadOnlyList<OrganizerBatch> batches = Array.Empty<OrganizerBatch>(); private readonly CampaignInput campaignInput = new(); private readonly TemplateInput templateInput = new(); private string? error;
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task RefreshAsync() { campaigns = await EmailCampaignService.GetCampaignsAsync(); templates = await EmailCampaignService.GetTemplatesAsync(); batches = await OrganizerService.GetBatchesAsync(); }
    private async Task CreateTemplateAsync() { try { await EmailCampaignService.CreateTemplateAsync(new EmailTemplateInput(templateInput.Type, templateInput.Subject, templateInput.HtmlBody, templateInput.PlainTextBody)); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is ArgumentException or InvalidOperationException) { error = exception.Message; } }
    private async Task ApproveTemplateAsync(EmailTemplateSummary template) { try { await EmailCampaignService.ApproveTemplateAsync(template.Id, template.Version); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is StaleDataException or InvalidOperationException) { error = exception.Message; await RefreshAsync(); } }
    private async Task PrepareCampaignAsync() { if (campaignInput.BatchId is null || campaignInput.TemplateId is null) { error = "Select a committed batch and an approved template."; return; } try { await EmailCampaignService.PrepareInitialCampaignAsync(campaignInput.BatchId.Value, campaignInput.TemplateId.Value); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; } }
    private sealed class CampaignInput { public Guid? BatchId { get; set; } public Guid? TemplateId { get; set; } }
    private sealed class TemplateInput { public EmailTemplateType Type { get; set; } = EmailTemplateType.InitialInvitation; [Required] public string Subject { get; set; } = string.Empty; [Required] public string HtmlBody { get; set; } = string.Empty; [Required] public string PlainTextBody { get; set; } = string.Empty; }
}
