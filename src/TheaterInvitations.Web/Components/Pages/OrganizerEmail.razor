@page "/organizer/email"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject EmailCampaignService EmailCampaignService
@inject OrganizerService OrganizerService

    <PageTitle>E-mailové kampaně</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Pořadatel</p><h1>E-mailové kampaně</h1><OrganizerNavigation /></header>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
    <section class="rsvp-card">
        <h2>Kampaně</h2>
        <p>Příprava kampaně uloží přehled příjemců ke kontrole. Odeslání je ručně potvrzovaná operace na serveru.</p>
        @if (campaigns.Count == 0) { <p>Dosud nebyly připraveny žádné e-mailové kampaně.</p> }
        else { <div class="saved-draft-list">@foreach (var campaign in campaigns) { <div><a class="button-secondary" href="/organizer/email/@campaign.Id">Zkontrolovat</a><span><strong>@CzechPresentationFormatter.CampaignType(campaign.Type) pro dávku @campaign.BatchName</strong><br /><small>@CzechPresentationFormatter.CampaignState(campaign.State), šablona @campaign.TemplateName (v@(campaign.TemplateVersionNumber)), @campaign.RecipientCount příjemců, připraveno @campaign.CreatedAtUtc.ToString("u")</small></span></div> }</div> }
    </section>
    <AuthorizeView Roles="Operator,ElevatedOperator" Context="emailAuth"><Authorized>
        <section class="rsvp-card"><h2>Vytvořit kampaň</h2><EditForm Model="campaignInput" OnValidSubmit="PrepareCampaignAsync" FormName="email-campaign" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>Typ kampaně <InputSelect @bind-Value="campaignInput.Type"><option value="@EmailCampaignType.InitialInvitation">První pozvánka</option><option value="@EmailCampaignType.Reminder">Připomenutí</option></InputSelect></label><label>Potvrzená dávka <InputSelect @bind-Value="campaignInput.BatchIdText"><option value="">Vyberte dávku</option>@foreach (var batch in batches.Where(x => x.State == InvitationBatchState.Committed)) { <option value="@batch.Id.ToString()">@batch.Name</option> }</InputSelect></label><label>Aktivní šablona <InputSelect @bind-Value="campaignInput.TemplateIdText"><option value="">Vyberte šablonu</option>@foreach (var template in templates.Where(x => x.Type == RequiredTemplateType && x.State == EmailTemplateState.Active)) { <option value="@template.Id.ToString()">@($"{template.Name} · v{template.VersionNumber}")</option> }</InputSelect></label><button type="submit">Připravit kampaň ke kontrole</button></EditForm></section>
        <section class="rsvp-card"><h2>Zkušební odeslání</h2><p class="form-help">Odešle aktivní šablonu na kontrolovanou adresu bez vytvoření záznamů o kampani nebo odeslání pro skupinu.</p>@if (!templates.Any(x => x.State == EmailTemplateState.Active)) { <p class="notice">Před odesláním zkušebního e-mailu níže vytvořte aktivní šablonu.</p> }<EditForm Model="testSendInput" OnValidSubmit="SendTestAsync" FormName="email-test-send" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>Aktivní šablona <InputSelect @bind-Value="testSendInput.TemplateIdText"><option value="">Vyberte aktivní šablonu</option>@foreach (var template in templates.Where(x => x.State == EmailTemplateState.Active)) { <option value="@template.Id.ToString()">@($"{template.Name} · {CzechPresentationFormatter.TemplateType(template.Type)} v{template.VersionNumber}")</option> }</InputSelect></label><label>Zkušební příjemce <InputText @bind-Value="testSendInput.RecipientEmail" /></label><button type="submit" disabled="@(templates.All(x => x.State != EmailTemplateState.Active))">Odeslat zkušební e-mail</button></EditForm></section>
        <section class="rsvp-card"><h2>Šablony</h2><p class="form-help">Podporované zástupné symboly: <code>{{guest_name}}</code>, <code>{{allocation}}</code>, <code>{{event_name}}</code>, <code>{{event_date}}</code>, <code>{{doors_time}}</code>, <code>{{start_time}}</code>, <code>{{venue_name}}</code>, <code>{{venue_address}}</code>, <code>{{deadline}}</code>, <code>{{rsvp_url}}</code> a <code>{{support_email}}</code>.</p><EditForm Model="templateInput" OnValidSubmit="CreateTemplateAsync" FormName="email-template" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>Typ <InputSelect @bind-Value="templateInput.Type"><option value="@EmailTemplateType.InitialInvitation">První pozvánka</option><option value="@EmailTemplateType.Reminder">Připomenutí</option></InputSelect></label><label>Název šablony <InputText @bind-Value="templateInput.Name" /></label><label>Předmět e-mailu <InputText @bind-Value="templateInput.Subject" /></label><label>Tělo HTML <InputTextArea @bind-Value="templateInput.HtmlBody" /></label><label>Textové tělo <InputTextArea @bind-Value="templateInput.PlainTextBody" /></label><button type="submit">Vytvořit aktivní šablonu</button></EditForm>@if (templates.Count > 0) { <div class="saved-draft-list">@foreach (var template in templates) { <div><span><strong>@template.Name</strong><br /><small>@CzechPresentationFormatter.TemplateType(template.Type) v@(template.VersionNumber), @CzechPresentationFormatter.TemplateState(template.State)<br />Předmět: @template.Subject</small></span></div> }</div> }</section>
    </Authorized></AuthorizeView>
</main>
@code {
    private IReadOnlyList<EmailCampaignSummary> campaigns = Array.Empty<EmailCampaignSummary>(); private IReadOnlyList<EmailTemplateSummary> templates = Array.Empty<EmailTemplateSummary>(); private IReadOnlyList<OrganizerBatch> batches = Array.Empty<OrganizerBatch>(); private readonly CampaignInput campaignInput = new(); private readonly TemplateInput templateInput = new(); private readonly TestSendInput testSendInput = new(); private string? error;
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task RefreshAsync() { campaigns = await EmailCampaignService.GetCampaignsAsync(); templates = await EmailCampaignService.GetTemplatesAsync(); batches = await OrganizerService.GetBatchesAsync(); if (string.IsNullOrEmpty(testSendInput.TemplateIdText)) testSendInput.TemplateIdText = templates.FirstOrDefault(x => x.State == EmailTemplateState.Active)?.Id.ToString() ?? string.Empty; }
    private async Task CreateTemplateAsync() { try { await EmailCampaignService.CreateTemplateAsync(new EmailTemplateInput(templateInput.Type, templateInput.Name, templateInput.Subject, templateInput.HtmlBody, templateInput.PlainTextBody)); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is ArgumentException or InvalidOperationException) { error = exception.Message; } }
    private async Task PrepareCampaignAsync() { if (!Guid.TryParse(campaignInput.BatchIdText, out var batchId) || !Guid.TryParse(campaignInput.TemplateIdText, out var templateId)) { error = "Vyberte potvrzenou dávku a schválenou šablonu."; return; } try { if (campaignInput.Type == EmailCampaignType.InitialInvitation) await EmailCampaignService.PrepareInitialCampaignAsync(batchId, templateId); else await EmailCampaignService.PrepareReminderCampaignAsync(batchId, templateId); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; } }
    private async Task SendTestAsync() { if (!Guid.TryParse(testSendInput.TemplateIdText, out var templateId)) { error = "Vyberte schválenou šablonu pro zkušební odeslání."; return; } try { await EmailCampaignService.SendTestAsync(templateId, testSendInput.RecipientEmail); error = "Zkušební e-mail byl poskytovatelem přijat."; } catch (Exception exception) when (exception is ArgumentException or InvalidOperationException) { error = exception.Message; } }
    private EmailTemplateType RequiredTemplateType => campaignInput.Type == EmailCampaignType.Reminder ? EmailTemplateType.Reminder : EmailTemplateType.InitialInvitation;
    private sealed class CampaignInput { public EmailCampaignType Type { get; set; } = EmailCampaignType.InitialInvitation; public string BatchIdText { get; set; } = string.Empty; public string TemplateIdText { get; set; } = string.Empty; }
    private sealed class TestSendInput { public string TemplateIdText { get; set; } = string.Empty; [Required, EmailAddress] public string RecipientEmail { get; set; } = string.Empty; }
    private sealed class TemplateInput { public EmailTemplateType Type { get; set; } = EmailTemplateType.InitialInvitation; [Required] public string Name { get; set; } = string.Empty; [Required] public string Subject { get; set; } = string.Empty; [Required] public string HtmlBody { get; set; } = string.Empty; [Required] public string PlainTextBody { get; set; } = string.Empty; }
}
