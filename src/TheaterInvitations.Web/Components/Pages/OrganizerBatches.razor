@page "/organizer/batches"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject OrganizerService OrganizerService

<PageTitle>Batch management</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Organizer</p><h1>Batch management</h1><OrganizerNavigation /></header>
    @if (dashboard is null) { <p>Loading batch data...</p> }
    else
    {
        <section class="rsvp-card">
            <h2>Create batch draft</h2>
            <p>Upload CSV columns: <code>primary_guest_name,email,company,allocated_seats</code>.</p>
            <AuthorizeView Roles="Operator,ElevatedOperator" Context="draftAuth"><Authorized>
                @if (dashboard.Configuration is null) { <p class="validation-message">Configure the event before creating a batch draft.</p> }
                else
                {
                    <EditForm Model="draftInput" OnValidSubmit="SaveDraftAsync" OnInvalidSubmit="InvalidDraftSubmit" FormName="batch-draft" class="manage-form batch-draft-form">
                        <DataAnnotationsValidator /><ValidationSummary />
                        <div class="batch-draft-fields"><label>Batch name <InputText @bind-Value="draftInput.Name" /> <ValidationMessage For="@(() => draftInput.Name)" /></label><label>Deadline <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="draftInput.DeadlineLocal" /></label></div>
                        <p class="form-help">All batch deadlines use <strong>@dashboard.Configuration.TimeZoneId</strong>. Capacity is checked again when you commit.</p>
                        <label class="file-picker">CSV file <InputFile OnChange="SelectDraftFile" accept=".csv,text/csv" /></label>
                        @if (draftFile is not null) { <p class="file-selected">Selected: @draftFile.Name</p> }
                        @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
                        <button type="submit">Save draft for review</button>
                    </EditForm>
                }
            </Authorized><NotAuthorized><p>You have read-only access to batches.</p></NotAuthorized></AuthorizeView>
        </section>

        @if (selectedDraft is not null)
        {
            <section class="rsvp-card"><div class="draft-review"><div class="draft-review-heading"><div><p class="eyebrow">Draft review</p><h2>@selectedDraft.Name</h2></div><span class="draft-state">@selectedDraft.State</span></div><p>@selectedDraft.Rows.Count rows: <strong>@selectedDraft.Rows.Count(x => x.ValidationIssue is null) valid</strong>, @selectedDraft.Rows.Count(x => x.ValidationIssue is not null) invalid. Deadline: @FormatDeadline(selectedDraft.DeadlineUtc).</p>
                @if (!string.IsNullOrWhiteSpace(selectedDraft.ValidationIssue)) { <p class="validation-message">@selectedDraft.ValidationIssue</p> }
                @foreach (var row in selectedDraft.Rows.Where(x => x.ValidationIssue is not null)) { <p class="validation-message">Row @row.SourceRowNumber: @row.ValidationIssue</p> }
                <AuthorizeView Roles="Operator,ElevatedOperator" Context="reviewAuth"><Authorized>
                    @if (selectedDraft.State == InvitationBatchState.Prepared)
                    {
                        @if (confirmingCommit) { <p class="notice">Commit this batch? Capacity and duplicate emails will be rechecked before parties are created.</p><button @onclick="CommitDraftAsync">Confirm commit</button> <button class="button-secondary" @onclick="(() => confirmingCommit = false)">Cancel</button> }
                        else { <button @onclick="(() => confirmingCommit = true)">Commit draft batch</button> }
                    }
                    @if (confirmingDelete) { <p class="notice">Delete this draft and all of its saved rows? This cannot be undone.</p><button class="button-danger" @onclick="DeleteDraftAsync">Delete draft</button> <button class="button-secondary" @onclick="(() => confirmingDelete = false)">Cancel</button> }
                    else { <button class="button-secondary" @onclick="(() => confirmingDelete = true)">Delete draft</button> }
                </Authorized></AuthorizeView>
            </div></section>
        }

        <section class="rsvp-card"><h2>Saved drafts</h2>
            @if (drafts.Count == 0) { <p>No drafts are waiting for review.</p> }
            else { <div class="saved-draft-list">@foreach (var draft in drafts) { <div><button class="button-secondary" @onclick="(() => LoadDraftAsync(draft.Id))">Review</button><span><strong>@draft.Name</strong><br /><small>@draft.State, deadline @FormatDeadline(draft.DeadlineUtc)</small></span></div> }</div> }
        </section>

        <section class="rsvp-card"><h2>Committed batch deadline</h2><AuthorizeView Roles="ElevatedOperator" Context="deadlineAuth"><Authorized><div class="manage-form deadline-change-form"><p>Changing a deadline can reactivate expired pending invitations. Capacity is rechecked when you confirm.</p><label>Batch <InputSelect @bind-Value="deadlineChange.BatchId" @bind-Value:after="SelectDeadlineBatchAsync"><option value="">Select a committed batch</option>@foreach (var batch in batches.Where(x => x.State == InvitationBatchState.Committed)) { <option value="@batch.Id">@batch.Name</option> }</InputSelect></label>@if (SelectedCommittedBatch is { } selectedBatch) { <p class="deadline-current">Current deadline: <strong>@FormatDeadline(selectedBatch.DeadlineUtc)</strong></p> }<label>New deadline (@dashboard.Configuration?.TimeZoneId) <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="deadlineChange.DeadlineLocal" /></label><label>Reason <InputText @bind-Value="deadlineChange.Reason" /></label>@if (confirmingDeadline) { <p class="notice">Confirm the deadline change. Current capacity and batch version will be checked again.</p><button @onclick="ChangeDeadlineAsync">Confirm deadline change</button> <button class="button-secondary" @onclick="(() => confirmingDeadline = false)">Cancel</button> } else { <button @onclick="(() => confirmingDeadline = true)" disabled="@(deadlineChange.BatchId is null)">Change deadline</button> }</div></Authorized><NotAuthorized><p>Only elevated operators can change committed deadlines.</p></NotAuthorized></AuthorizeView></section>
    }
</main>

@code {
    private OrganizerDashboard? dashboard; private IReadOnlyList<OrganizerBatch> batches = Array.Empty<OrganizerBatch>(); private IReadOnlyList<OrganizerDraft> drafts = Array.Empty<OrganizerDraft>(); private OrganizerDraftDetail? selectedDraft; private readonly BatchDraftModel draftInput = new(); private readonly DeadlineChangeModel deadlineChange = new(); private IBrowserFile? draftFile; private string? error; private bool confirmingCommit; private bool confirmingDelete; private bool confirmingDeadline;
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task RefreshAsync() { dashboard = await OrganizerService.GetDashboardAsync(); batches = await OrganizerService.GetBatchesAsync(); drafts = await OrganizerService.GetDraftsAsync(); }
    private void SelectDraftFile(InputFileChangeEventArgs args) { draftFile = args.File; error = null; }
    private void InvalidDraftSubmit() => error = "Enter a batch name and deadline, then choose a CSV file.";
    private async Task SaveDraftAsync() { if (draftFile is null) { error = "Choose a CSV file before saving the draft."; return; } try { await using var stream = draftFile.OpenReadStream(1_000_000); using var reader = new StreamReader(stream, new System.Text.UTF8Encoding(false, true), true); selectedDraft = await OrganizerService.SaveDraftAsync(new BatchDraftInput(draftInput.Name, draftInput.DeadlineLocal), await reader.ReadToEndAsync()); error = null; confirmingDelete = false; await RefreshAsync(); } catch (Exception exception) when (exception is IOException or ArgumentException or InvalidOperationException) { error = exception is IOException ? "CSV must be valid UTF-8 and 1 MB or smaller." : exception.Message; } }
    private async Task LoadDraftAsync(Guid id) { selectedDraft = await OrganizerService.GetDraftAsync(id); confirmingCommit = false; confirmingDelete = false; error = selectedDraft is null ? "That draft is no longer available." : null; }
    private async Task CommitDraftAsync() { if (selectedDraft is null) return; var id = selectedDraft.Id; try { await OrganizerService.CommitDraftAsync(id, selectedDraft.Version); selectedDraft = null; confirmingCommit = false; error = null; await RefreshAsync(); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; selectedDraft = await OrganizerService.GetDraftAsync(id); confirmingCommit = false; } }
    private async Task DeleteDraftAsync() { if (selectedDraft is null) return; var id = selectedDraft.Id; try { await OrganizerService.DeleteDraftAsync(id, selectedDraft.Version); selectedDraft = null; confirmingDelete = false; error = null; await RefreshAsync(); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; selectedDraft = await OrganizerService.GetDraftAsync(id); confirmingDelete = false; } }
    private Task SelectDeadlineBatchAsync() { confirmingDeadline = false; if (SelectedCommittedBatch is { } batch && dashboard?.Configuration is not null) deadlineChange.DeadlineLocal = TimeZoneInfo.ConvertTime(batch.DeadlineUtc, TimeZoneInfo.FindSystemTimeZoneById(dashboard.Configuration.TimeZoneId)).DateTime; return Task.CompletedTask; }
    private async Task ChangeDeadlineAsync() { if (SelectedCommittedBatch is not { } batch) { error = "Select a committed batch."; return; } try { await OrganizerService.ChangeBatchDeadlineAsync(batch.Id, batch.Version, deadlineChange.DeadlineLocal, deadlineChange.Reason); confirmingDeadline = false; error = null; await RefreshAsync(); } catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or StaleDataException) { error = exception.Message; confirmingDeadline = false; await RefreshAsync(); } }
    private string FormatDeadline(DateTimeOffset deadline) { if (dashboard?.Configuration is null) return deadline.ToString("u"); var zone = TimeZoneInfo.FindSystemTimeZoneById(dashboard.Configuration.TimeZoneId); return $"{TimeZoneInfo.ConvertTime(deadline, zone):f} ({dashboard.Configuration.TimeZoneId})"; }
    private OrganizerBatch? SelectedCommittedBatch => deadlineChange.BatchId is null ? null : batches.SingleOrDefault(x => x.Id == deadlineChange.BatchId && x.State == InvitationBatchState.Committed);
    private sealed class BatchDraftModel { [Required] public string Name { get; set; } = string.Empty; public DateTime DeadlineLocal { get; set; } = DateTime.Today.AddDays(14).AddHours(18); }
    private sealed class DeadlineChangeModel { public Guid? BatchId { get; set; } public DateTime DeadlineLocal { get; set; } = DateTime.Today.AddDays(14).AddHours(18); public string Reason { get; set; } = string.Empty; }
}
