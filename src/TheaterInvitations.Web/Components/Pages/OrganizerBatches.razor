@page "/organizer/batches"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject OrganizerService OrganizerService

<PageTitle>Správa dávek</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Pořadatel</p><h1>Správa dávek</h1><OrganizerNavigation /></header>
    @if (dashboard is null) { <p>Načítání údajů o dávkách...</p> }
    else
    {
        <section class="rsvp-card">
            <h2>Vytvořit návrh dávky</h2>
            <p>Nahrajte sloupce CSV: <code>primary_guest_name,email,company,allocated_seats</code>.</p>
            <AuthorizeView Roles="Operator,ElevatedOperator" Context="draftAuth"><Authorized>
                @if (dashboard.Configuration is null) { <p class="validation-message">Před vytvořením návrhu dávky nastavte akci.</p> }
                else
                {
                    <EditForm Model="draftInput" OnValidSubmit="SaveDraftAsync" OnInvalidSubmit="InvalidDraftSubmit" FormName="batch-draft" class="manage-form batch-draft-form">
                        <DataAnnotationsValidator /><ValidationSummary />
                         <div class="batch-draft-fields"><label>Název dávky <InputText @bind-Value="draftInput.Name" /> <ValidationMessage For="@(() => draftInput.Name)" /></label><label>Termín <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="draftInput.DeadlineLocal" /></label></div>
                         <p class="form-help">Všechny termíny dávek používají <strong>@dashboard.Configuration.TimeZoneId</strong>. Kapacita se znovu ověří při potvrzení.</p>
                         <label class="file-picker">Soubor CSV <InputFile OnChange="SelectDraftFile" accept=".csv,text/csv" /></label>
                         @if (draftFile is not null) { <p class="file-selected">Vybráno: @draftFile.Name</p> }
                        @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
                         <button type="submit">Uložit návrh ke kontrole</button>
                    </EditForm>
                }
             </Authorized><NotAuthorized><p>K dávkám máte přístup pouze pro čtení.</p></NotAuthorized></AuthorizeView>
        </section>

        @if (selectedDraft is not null)
        {
            <section class="rsvp-card"><div class="draft-review"><div class="draft-review-heading"><div><p class="eyebrow">Kontrola návrhu</p><h2>@selectedDraft.Name</h2></div><span class="draft-state">@CzechPresentationFormatter.BatchState(selectedDraft.State)</span></div><p>@selectedDraft.Rows.Count řádků: <strong>@selectedDraft.Rows.Count(x => x.ValidationIssue is null) platných</strong>, @selectedDraft.Rows.Count(x => x.ValidationIssue is not null) neplatných. Termín: @FormatDeadline(selectedDraft.DeadlineUtc).</p>
                @if (!string.IsNullOrWhiteSpace(selectedDraft.ValidationIssue)) { <p class="validation-message">@selectedDraft.ValidationIssue</p> }
                @foreach (var row in selectedDraft.Rows.Where(x => x.ValidationIssue is not null)) { <p class="validation-message">Řádek @row.SourceRowNumber: @row.ValidationIssue</p> }
                <AuthorizeView Roles="Operator,ElevatedOperator" Context="reviewAuth"><Authorized>
                    @if (selectedDraft.State == InvitationBatchState.Prepared)
                    {
                        @if (confirmingCommit) { <p class="notice">Potvrdit tuto dávku? Před vytvořením skupin se znovu ověří kapacita a duplicitní e-maily.</p><button @onclick="CommitDraftAsync">Potvrdit potvrzení</button> <button class="button-secondary" @onclick="(() => confirmingCommit = false)">Zrušit</button> }
                        else { <button @onclick="(() => confirmingCommit = true)">Potvrdit návrh dávky</button> }
                    }
                    @if (confirmingDelete) { <p class="notice">Odstranit tento návrh a všechny jeho uložené řádky? Tuto akci nelze vrátit zpět.</p><button class="button-danger" @onclick="DeleteDraftAsync">Odstranit návrh</button> <button class="button-secondary" @onclick="(() => confirmingDelete = false)">Zrušit</button> }
                    else { <button class="button-secondary" @onclick="(() => confirmingDelete = true)">Odstranit návrh</button> }
                </Authorized></AuthorizeView>
            </div></section>
        }

        <section class="rsvp-card"><h2>Uložené návrhy</h2>
            @if (drafts.Count == 0) { <p>Žádné návrhy nečekají na kontrolu.</p> }
            else { <div class="saved-draft-list">@foreach (var draft in drafts) { <div><button class="button-secondary" @onclick="(() => LoadDraftAsync(draft.Id))">Zkontrolovat</button><span><strong>@draft.Name</strong><br /><small>@CzechPresentationFormatter.BatchState(draft.State), termín @FormatDeadline(draft.DeadlineUtc)</small></span></div> }</div> }
        </section>

        <section class="rsvp-card"><h2>Termín potvrzené dávky</h2><AuthorizeView Roles="ElevatedOperator" Context="deadlineAuth"><Authorized><div class="manage-form deadline-change-form"><p>Změna termínu může znovu aktivovat pozvánky s prošlým termínem, na které zatím nebylo odpovězeno. Při potvrzení se znovu ověří kapacita.</p><label>Dávka <InputSelect @bind-Value="deadlineChange.BatchId" @bind-Value:after="SelectDeadlineBatchAsync"><option value="">Vyberte potvrzenou dávku</option>@foreach (var batch in batches.Where(x => x.State == InvitationBatchState.Committed)) { <option value="@batch.Id">@batch.Name</option> }</InputSelect></label>@if (SelectedCommittedBatch is { } selectedBatch) { <p class="deadline-current">Aktuální termín: <strong>@FormatDeadline(selectedBatch.DeadlineUtc)</strong></p> }<label>Nový termín (@dashboard.Configuration?.TimeZoneId) <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="deadlineChange.DeadlineLocal" /></label><label>Důvod <InputText @bind-Value="deadlineChange.Reason" /></label>@if (confirmingDeadline) { <p class="notice">Potvrďte změnu termínu. Aktuální kapacita a verze dávky se znovu ověří.</p><button @onclick="ChangeDeadlineAsync">Potvrdit změnu termínu</button> <button class="button-secondary" @onclick="(() => confirmingDeadline = false)">Zrušit</button> } else { <button @onclick="(() => confirmingDeadline = true)" disabled="@(deadlineChange.BatchId is null)">Změnit termín</button> }</div></Authorized><NotAuthorized><p>Termíny potvrzených dávek mohou měnit pouze uživatelé s rozšířeným oprávněním.</p></NotAuthorized></AuthorizeView></section>
    }
</main>

@code {
    private OrganizerDashboard? dashboard; private IReadOnlyList<OrganizerBatch> batches = Array.Empty<OrganizerBatch>(); private IReadOnlyList<OrganizerDraft> drafts = Array.Empty<OrganizerDraft>(); private OrganizerDraftDetail? selectedDraft; private readonly BatchDraftModel draftInput = new(); private readonly DeadlineChangeModel deadlineChange = new(); private IBrowserFile? draftFile; private string? error; private bool confirmingCommit; private bool confirmingDelete; private bool confirmingDeadline;
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task RefreshAsync() { dashboard = await OrganizerService.GetDashboardAsync(); batches = await OrganizerService.GetBatchesAsync(); drafts = await OrganizerService.GetDraftsAsync(); }
    private void SelectDraftFile(InputFileChangeEventArgs args) { draftFile = args.File; error = null; }
    private void InvalidDraftSubmit() => error = "Zadejte název dávky a termín a potom vyberte soubor CSV.";
    private async Task SaveDraftAsync() { if (draftFile is null) { error = "Před uložením návrhu vyberte soubor CSV."; return; } try { await using var stream = draftFile.OpenReadStream(1_000_000); using var reader = new StreamReader(stream, new System.Text.UTF8Encoding(false, true), true); selectedDraft = await OrganizerService.SaveDraftAsync(new BatchDraftInput(draftInput.Name, draftInput.DeadlineLocal), await reader.ReadToEndAsync()); error = null; confirmingDelete = false; await RefreshAsync(); } catch (Exception exception) when (exception is IOException or ArgumentException or InvalidOperationException) { error = exception is IOException ? "CSV musí být platné UTF-8 a nesmí být větší než 1 MB." : exception.Message; } }
    private async Task LoadDraftAsync(Guid id) { selectedDraft = await OrganizerService.GetDraftAsync(id); confirmingCommit = false; confirmingDelete = false; error = selectedDraft is null ? "Tento návrh už není dostupný." : null; }
    private async Task CommitDraftAsync() { if (selectedDraft is null) return; var id = selectedDraft.Id; try { await OrganizerService.CommitDraftAsync(id, selectedDraft.Version); selectedDraft = null; confirmingCommit = false; error = null; await RefreshAsync(); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; selectedDraft = await OrganizerService.GetDraftAsync(id); confirmingCommit = false; } }
    private async Task DeleteDraftAsync() { if (selectedDraft is null) return; var id = selectedDraft.Id; try { await OrganizerService.DeleteDraftAsync(id, selectedDraft.Version); selectedDraft = null; confirmingDelete = false; error = null; await RefreshAsync(); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; selectedDraft = await OrganizerService.GetDraftAsync(id); confirmingDelete = false; } }
    private Task SelectDeadlineBatchAsync() { confirmingDeadline = false; if (SelectedCommittedBatch is { } batch && dashboard?.Configuration is not null) deadlineChange.DeadlineLocal = TimeZoneInfo.ConvertTime(batch.DeadlineUtc, TimeZoneInfo.FindSystemTimeZoneById(dashboard.Configuration.TimeZoneId)).DateTime; return Task.CompletedTask; }
    private async Task ChangeDeadlineAsync() { if (SelectedCommittedBatch is not { } batch) { error = "Vyberte potvrzenou dávku."; return; } try { await OrganizerService.ChangeBatchDeadlineAsync(batch.Id, batch.Version, deadlineChange.DeadlineLocal, deadlineChange.Reason); confirmingDeadline = false; error = null; await RefreshAsync(); } catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or StaleDataException) { error = exception.Message; confirmingDeadline = false; await RefreshAsync(); } }
    private string FormatDeadline(DateTimeOffset deadline) { if (dashboard?.Configuration is null) return deadline.ToString("u", CzechPresentationFormatter.Culture); var zone = TimeZoneInfo.FindSystemTimeZoneById(dashboard.Configuration.TimeZoneId); return CzechPresentationFormatter.FormatOrganizerDeadline(deadline, zone); }
    private OrganizerBatch? SelectedCommittedBatch => deadlineChange.BatchId is null ? null : batches.SingleOrDefault(x => x.Id == deadlineChange.BatchId && x.State == InvitationBatchState.Committed);
    private sealed class BatchDraftModel { [Required] public string Name { get; set; } = string.Empty; public DateTime DeadlineLocal { get; set; } = DateTime.Today.AddDays(14).AddHours(18); }
    private sealed class DeadlineChangeModel { public Guid? BatchId { get; set; } public DateTime DeadlineLocal { get; set; } = DateTime.Today.AddDays(14).AddHours(18); public string Reason { get; set; } = string.Empty; }
}
