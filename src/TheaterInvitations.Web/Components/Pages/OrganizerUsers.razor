@page "/organizer/users"
@attribute [Authorize(Policy = "ElevatedOperator")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TheaterInvitations.Web.Services
@inject OrganizerUserService UserService

<PageTitle>Účty pořadatelů</PageTitle>
<main class="organizer-page"><header><p class="eyebrow">Pořadatel</p><h1>Účty pořadatelů</h1><OrganizerNavigation /></header>
@if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
<section class="rsvp-card"><h2>Vytvořit účet</h2><EditForm Model="model" OnValidSubmit="CreateAsync" FormName="organizer-user" class="manage-form"><DataAnnotationsValidator /><ValidationSummary /><label>E-mail <InputText @bind-Value="model.Email" /></label><label>Dočasné heslo <InputText type="password" @bind-Value="model.Password" /></label><label>Role <InputSelect @bind-Value="model.Role"><option value="Operator">Operátor</option><option value="ElevatedOperator">Rozšířený operátor</option></InputSelect></label><button type="submit">Vytvořit účet pořadatele</button></EditForm></section>
<section class="rsvp-card"><h2>Účty</h2><table><thead><tr><th>E-mail</th><th>Stav účtu</th><th></th></tr></thead><tbody>@foreach (var user in users) { <tr><td>@user.Email</td><td>@(user.IsDisabled ? "Deaktivován" : "Aktivní")</td><td>@if (!user.IsDisabled) { <button class="button-danger" @onclick="(() => DisableAsync(user.Id))">Deaktivovat</button> }</td></tr> }</tbody></table></section>
</main>
@code { private IReadOnlyList<OrganizerUser> users = Array.Empty<OrganizerUser>(); private readonly UserModel model = new(); private string? error; protected override async Task OnInitializedAsync() => await RefreshAsync(); private async Task RefreshAsync() => users = await UserService.GetUsersAsync(); private async Task CreateAsync() { try { await UserService.CreateUserAsync(model.Email, model.Password, model.Role); error = null; model.Email = string.Empty; model.Password = string.Empty; await RefreshAsync(); } catch (Exception exception) when (exception is ArgumentException or InvalidOperationException) { error = exception.Message; } } private async Task DisableAsync(string id) { try { await UserService.DisableUserAsync(id); error = null; await RefreshAsync(); } catch (Exception exception) when (exception is InvalidOperationException or UnauthorizedAccessException) { error = exception.Message; } } private sealed class UserModel { [Required, EmailAddress] public string Email { get; set; } = string.Empty; [Required] public string Password { get; set; } = string.Empty; public string Role { get; set; } = "Operator"; } }
