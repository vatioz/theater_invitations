@page "/Error"
@using System.Diagnostics

<PageTitle>Chyba</PageTitle>

<h1 class="text-danger">Chyba.</h1>
<h2 class="text-danger">Při zpracování požadavku došlo k chybě.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID požadavku:</strong> <code>@RequestId</code>
    </p>
}

<h3>Vývojový režim</h3>
<p>
    Přepnutí do prostředí <strong>Development</strong> zobrazí podrobnější informace o vzniklé chybě.
</p>
<p>
    <strong>Pro nasazenou aplikaci by prostředí Development nemělo být povoleno.</strong>
    Mohlo by koncovým uživatelům zobrazit citlivé informace z výjimek.
    Pro místní ladění nastavte proměnnou prostředí <strong>ASPNETCORE_ENVIRONMENT</strong> na <strong>Development</strong>
    a aplikaci restartujte.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
