@using TheaterInvitations.Web.Services

<section class="event-details" aria-label="Informace o akci">
    <p class="eyebrow">Informace o akci</p>
    @if (ShowEventName)
    {
        <h2>@Invitation.EventName</h2>
    }
    <dl>
        <div><dt>Datum</dt><dd><time datetime="@LocalStart.ToString("yyyy-MM-dd")">@CzechPresentationFormatter.FormatPublicDate(Invitation.StartsAtUtc, TimeZone)</time></dd></div>
        <div><dt>Otevření</dt><dd><time datetime="@Invitation.DoorsAtUtc.ToString("O")">@CzechPresentationFormatter.FormatPublicTime(Invitation.DoorsAtUtc, TimeZone)</time></dd></div>
        <div><dt>Začátek</dt><dd><time datetime="@Invitation.StartsAtUtc.ToString("O")">@CzechPresentationFormatter.FormatPublicTime(Invitation.StartsAtUtc, TimeZone)</time></dd></div>
        <div><dt>Místo</dt><dd>@Invitation.VenueName</dd></div>
        <div><dt>Adresa</dt><dd class="event-address">@Invitation.VenueAddress</dd></div>
        @if (!string.IsNullOrWhiteSpace(Invitation.DressCode))
        {
            <div><dt>Dress code</dt><dd>@Invitation.DressCode</dd></div>
        }
    </dl>
</section>

@code {
    [Parameter, EditorRequired] public RsvpInvitation Invitation { get; set; } = default!;
    [Parameter] public bool ShowEventName { get; set; } = true;

    private TimeZoneInfo TimeZone => TimeZoneInfo.FindSystemTimeZoneById(Invitation.TimeZoneId);
    private DateTimeOffset LocalDoors => TimeZoneInfo.ConvertTime(Invitation.DoorsAtUtc, TimeZone);
    private DateTimeOffset LocalStart => TimeZoneInfo.ConvertTime(Invitation.StartsAtUtc, TimeZone);
}
