@page "/organizer/email/{CampaignId:guid}"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject EmailCampaignService EmailCampaignService

    <PageTitle>Kontrola kampaně</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Pořadatel</p><h1>Kontrola kampaně</h1><OrganizerNavigation /></header>
    @if (campaign is null) { <p>Načítání kampaně...</p> }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
        <section class="rsvp-card"><div class="section-heading"><div><h2>@CzechPresentationFormatter.CampaignType(campaign.Type) pro dávku @campaign.BatchName</h2><p>Šablona v@(campaign.TemplateVersionNumber). Odesílatel: @campaign.FromDisplayName &lt;@campaign.FromAddress&gt;.</p></div><span class="draft-state">@CzechPresentationFormatter.CampaignState(campaign.State)</span></div><dl class="configuration-summary"><div><dt>Adresa pro odpověď</dt><dd>@campaign.ReplyToAddress</dd></div><div><dt>Příjemci</dt><dd>@campaign.Dispatches.Count příjemců ve frontě</dd></div></dl>
            <AuthorizeView Roles="Operator,ElevatedOperator" Context="confirmAuth"><Authorized>@if (campaign.State == EmailCampaignState.ReadyForReview) { @if (confirming) { <p class="notice">Zařadit zkontrolovanou kampaň do fronty? E-mail se neodešle, dokud nepoužijete tlačítko Odeslat kampaň.</p><button @onclick="ConfirmAsync">Potvrdit a zařadit kampaň do fronty</button> <button class="button-secondary" @onclick="(() => confirming = false)">Zrušit</button> } else { <button @onclick="(() => confirming = true)">Potvrdit a zařadit kampaň do fronty</button> } } else if (campaign.State is EmailCampaignState.Queued or EmailCampaignState.PartiallyFailed or EmailCampaignState.Failed) { @if (confirmingSend) { <p class="notice">Odeslat všem příjemcům ve frontě nebo s chybou? Příjemcům, pro které byl e-mail přijat, se e-mail znovu neodešle.</p><button @onclick="SendAsync">Odeslat kampaň</button> <button class="button-secondary" @onclick="(() => confirmingSend = false)">Zrušit</button> } else { <button @onclick="(() => confirmingSend = true)">@(campaign.State == EmailCampaignState.Queued ? "Odeslat kampaň" : "Zkusit znovu neúspěšné příjemce")</button> } }</Authorized></AuthorizeView>
        </section>
        <section class="rsvp-card"><h2>Náhled vykreslení</h2><p class="form-help">Náhled používá reprezentativní údaje a skrytý odkaz pro RSVP. E-mail neodesílá.</p><h3>@campaign.Preview.Subject</h3><div class="email-html-preview">@((MarkupString)campaign.Preview.HtmlBody)</div><h3>Prostý text</h3><pre class="email-text-preview">@campaign.Preview.PlainTextBody</pre></section>
        <section class="rsvp-card"><h2>Přehled příjemců</h2><div class="party-grid-wrap"><table><thead><tr><th>Jméno</th><th>E-mail</th><th>Místa</th><th>Stav</th><th>Pokusy</th><th>ID zprávy poskytovatele</th><th>Chyba</th></tr></thead><tbody>@foreach (var dispatch in campaign.Dispatches) { <tr><td>@dispatch.RecipientName</td><td>@dispatch.RecipientEmail</td><td>@CzechPresentationFormatter.Seats(dispatch.AllocatedSeats)</td><td>@CzechPresentationFormatter.DispatchState(dispatch.State)</td><td>@dispatch.AttemptCount</td><td>@(dispatch.ProviderMessageId ?? "-")</td><td>@(dispatch.FailureCategory ?? "-")</td></tr> }</tbody></table></div></section>
    }
</main>
@code {
    [Parameter] public Guid CampaignId { get; set; }
    private EmailCampaignDetail? campaign; private string? error; private bool confirming; private bool confirmingSend;
    protected override async Task OnParametersSetAsync() => campaign = await EmailCampaignService.GetCampaignAsync(CampaignId);
    private async Task ConfirmAsync() { if (campaign is null) return; try { await EmailCampaignService.ConfirmCampaignAsync(campaign.Id, campaign.Version); confirming = false; error = null; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; confirming = false; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } }
    private async Task SendAsync() { if (campaign is null) return; try { await EmailCampaignService.SendCampaignAsync(campaign.Id, campaign.Version); confirmingSend = false; error = null; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; confirmingSend = false; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } }
}
