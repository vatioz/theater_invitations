@page "/organizer/email/{CampaignId:guid}"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject EmailCampaignService EmailCampaignService
@inject NavigationManager NavigationManager

    <PageTitle>Kontrola kampaně</PageTitle>
<main class="organizer-page campaign-detail">
    <header><p class="eyebrow">Pořadatel</p><h1>Kontrola kampaně</h1><OrganizerNavigation /></header>
    @if (campaign is null) { <p>Načítání kampaně...</p> }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
         <section class="campaign-hero">
             <div class="campaign-hero-copy">
                 <p class="eyebrow">@(CzechPresentationFormatter.CampaignType(campaign.Type))</p>
                 <h2>@campaign.BatchName</h2>
                 <p class="campaign-meta">Šablona: @campaign.TemplateName (v@(campaign.TemplateVersionNumber)) <span aria-hidden="true">·</span> @campaign.FromDisplayName &lt;@campaign.FromAddress&gt;</p>
             </div>
             <span class="campaign-state">@CzechPresentationFormatter.CampaignState(campaign.State)</span>
         </section>
         <section class="campaign-metrics" aria-label="Souhrn kampaně">
             <div><span>Celkem</span><strong>@campaign.Dispatches.Count</strong><small>příjemců</small></div>
             <div><span>Přijato</span><strong>@campaign.Dispatches.Count(x => x.State is EmailDispatchState.Accepted or EmailDispatchState.Delivered)</strong><small>poskytovatelem</small></div>
             <div><span>Neúspěšné</span><strong>@campaign.Dispatches.Count(x => x.State is EmailDispatchState.Failed or EmailDispatchState.Bounced or EmailDispatchState.Complained or EmailDispatchState.Suppressed)</strong><small>příjemců</small></div>
             <div><span>Zbývá</span><strong>@campaign.Dispatches.Count(x => x.State is EmailDispatchState.Queued or EmailDispatchState.Prepared or EmailDispatchState.Sending)</strong><small>ke zpracování</small></div>
         </section>
         <section class="campaign-actions">
             <div><p class="eyebrow">Další krok</p><h2>@(campaign.State == EmailCampaignState.PausedDailyLimit ? "Kampaň čeká na obnovení limitu" : "Kampaň je připravena")</h2><p>@(campaign.State == EmailCampaignState.ReadyForReview ? "Zkontrolujte náhled a seznam příjemců. Odeslání začne okamžitě a při dosažení denního limitu se automaticky pozastaví." : campaign.State == EmailCampaignState.PausedDailyLimit ? $"Pokračovat lze {campaign.ContinueAfterUtc?.ToLocalTime().ToString("g") ?? "po obnovení limitu"}. Přijaté zprávy se znovu neodešlou." : "Tato kampaň již nečeká na ruční odeslání.")</p></div>
             <AuthorizeView Roles="Operator,ElevatedOperator" Context="confirmAuth">
                 <Authorized>
                     @if (campaign.State == EmailCampaignState.ReadyForReview)
                     {
                         @if (confirming)
                         {
                             <div class="campaign-confirm">
                                 <p>Odeslat kampaň všem způsobilým příjemcům?</p>
                                 <button @onclick="SendNowAsync">Ano, odeslat nyní</button>
                                 <button class="button-secondary" @onclick="(() => confirming = false)">Zrušit</button>
                             </div>
                         }
                         else
                         {
                             <button @onclick="(() => confirming = true)">Odeslat nyní</button>
                         }
                     }
                     else if (campaign.State == EmailCampaignState.PausedDailyLimit && campaign.ContinueAfterUtc is not null && DateTimeOffset.UtcNow >= campaign.ContinueAfterUtc)
                     {
                         <button @onclick="ContinueAsync">Pokračovat</button>
                     }
                 </Authorized>
             </AuthorizeView>
         </section>
         <section class="campaign-section"><div class="campaign-section-heading"><div><p class="eyebrow">Náhled</p><h2>Jak e-mail vypadá</h2></div><span class="section-note">Reprezentativní příjemce</span></div><div class="campaign-preview-grid"><div class="campaign-email-preview"><div class="campaign-email-toolbar"><span></span><span></span><span></span></div><h3>@campaign.Preview.Subject</h3><div class="email-html-preview">@((MarkupString)campaign.Preview.HtmlBody)</div></div><div><h3 class="preview-label">Prostý text</h3><pre class="email-text-preview">@campaign.Preview.PlainTextBody</pre></div></div></section>
          <section class="campaign-section"><div class="campaign-section-heading"><div><p class="eyebrow">Příjemci</p><h2>Přehled odesílání</h2></div><div class="campaign-section-tools"><span class="section-note">@campaign.Dispatches.Count příjemců</span><AuthorizeView Roles="Operator,ElevatedOperator"><Authorized><InputSelect @bind-Value="selectedResendTemplateId" aria-label="Šablona pro opětovné odeslání"><option value="">Vyberte šablonu</option>@foreach (var template in resendTemplates) { <option value="@template.Id">@template.Name · v@template.VersionNumber</option> }</InputSelect><button class="button-secondary" @onclick="PrepareResendAsync" disabled="@(selectedDispatchIds.Count == 0 || !Guid.TryParse(selectedResendTemplateId, out _))">Připravit opětovné odeslání (@selectedDispatchIds.Count)</button></Authorized></AuthorizeView></div></div>@if (campaign.Skips.Count > 0) { <div class="campaign-skips"><strong>Přeskočení při přípravě</strong><span>@campaign.Skips.Count příjemců nebylo zařazeno. Důvody: @string.Join(", ", campaign.Skips.GroupBy(x => x.ReasonCategory).Select(x => $"{x.Key} ({x.Count()})"))</span></div> }<div class="party-grid-wrap"><table><thead><tr><th>Vybrat</th><th>Jméno</th><th>E-mail</th><th>Místa</th><th>Stav</th><th>Pokusy</th><th>ID zprávy poskytovatele</th><th>Chyba</th></tr></thead><tbody>@foreach (var dispatch in campaign.Dispatches) { <tr><td><input type="checkbox" checked="@selectedDispatchIds.Contains(dispatch.Id)" @onchange="(() => ToggleSelection(dispatch.Id))" aria-label="Vybrat @dispatch.RecipientName" /></td><td>@dispatch.RecipientName</td><td>@dispatch.RecipientEmail</td><td>@CzechPresentationFormatter.Seats(dispatch.AllocatedSeats)</td><td><span class="dispatch-pill dispatch-@dispatch.State.ToString().ToLowerInvariant()">@CzechPresentationFormatter.DispatchState(dispatch.State)</span></td><td>@dispatch.AttemptCount</td><td>@(dispatch.ProviderMessageId ?? "-")</td><td>@(dispatch.FailureCategory ?? "-")</td></tr> }</tbody></table></div></section>
    }
</main>
@code {
    [Parameter] public Guid CampaignId { get; set; }
    private EmailCampaignDetail? campaign; private IReadOnlyList<EmailTemplateSummary> resendTemplates = Array.Empty<EmailTemplateSummary>(); private string? selectedResendTemplateId; private string? error; private bool confirming; private readonly HashSet<Guid> selectedDispatchIds = new();
    protected override async Task OnParametersSetAsync() { campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); if (campaign is not null) { resendTemplates = (await EmailCampaignService.GetTemplatesAsync()).Where(x => x.Type == campaign.TemplateType && x.State == EmailTemplateState.Active).ToList(); selectedResendTemplateId ??= resendTemplates.FirstOrDefault()?.Id.ToString(); } }
    private async Task SendNowAsync() { if (campaign is null) return; try { await EmailCampaignService.SendCampaignAsync(campaign.Id, campaign.Version); confirming = false; error = null; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; confirming = false; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } }
    private async Task ContinueAsync() { if (campaign is null) return; try { await EmailCampaignService.ContinueCampaignAsync(campaign.Id, campaign.Version); error = null; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } }
    private void ToggleSelection(Guid dispatchId) { if (!selectedDispatchIds.Add(dispatchId)) selectedDispatchIds.Remove(dispatchId); }
    private async Task PrepareResendAsync() { if (campaign is null || selectedDispatchIds.Count == 0 || !Guid.TryParse(selectedResendTemplateId, out var templateId)) return; try { var resend = await EmailCampaignService.PrepareSelectedResendCampaignAsync(campaign.Id, selectedDispatchIds, templateId); NavigationManager.NavigateTo($"/organizer/email/{resend.Id}"); } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; campaign = await EmailCampaignService.GetCampaignAsync(CampaignId); } }
}
