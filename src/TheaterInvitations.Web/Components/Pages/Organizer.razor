@page "/organizer"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using TheaterInvitations.Web.Services
@inject OrganizerService OrganizerService

<PageTitle>Organizer overview</PageTitle>

<main class="organizer-page">
    <header>
        <p class="eyebrow">Organizer</p>
        <h1>Invitation administration</h1>
        <p>Development access: <a href="/dev/login/Viewer">Viewer</a> | <a href="/dev/login/Operator">Operator</a> | <a href="/dev/login/ElevatedOperator">Elevated operator</a> | <a href="/dev/logout">Sign out</a></p>
        <OrganizerNavigation />
    </header>

    @if (dashboard is null)
    {
        <p>Loading invitation data...</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(actionError))
        {
            <p class="validation-message" role="alert">@actionError</p>
        }
        <section class="metrics" aria-label="Invitation metrics">
            <p><strong>@dashboard.ConfirmedSeats</strong> confirmed seats</p>
            <p><strong>@dashboard.ActivePendingSeats</strong> active pending seats</p>
            <p><strong>@dashboard.RemainingCapacity</strong> remaining seats</p>
            <p><strong>@dashboard.PartyCount</strong> parties</p>
        </section>

        <div class="overview-grid">
            <section class="rsvp-card overview-card">
                <h2>RSVP status</h2>
                <p>Guest RSVP is currently <strong>@(dashboard.IsRsvpLocked ? "locked" : "open")</strong>.</p>
                @if (dashboard.Configuration is null)
                {
                    <p class="validation-message">Event configuration is incomplete. RSVP submissions are unavailable.</p>
                }
                else
                {
                    <p>Support: @(string.IsNullOrWhiteSpace(dashboard.Configuration.SupportEmail) ? "not configured" : dashboard.Configuration.SupportEmail).</p>
                }
                <AuthorizeView Roles="ElevatedOperator" Context="lockAuth">
                    <Authorized>
                        @if (confirmingLock)
                        {
                            <p class="notice">Confirm that you want to @(dashboard.IsRsvpLocked ? "unlock" : "lock") all guest RSVP changes.</p>
                            <button @onclick="ToggleLockAsync">Confirm</button> <button class="button-secondary" @onclick="(() => confirmingLock = false)">Cancel</button>
                        }
                        else
                        {
                            <button @onclick="(() => confirmingLock = true)">@(dashboard.IsRsvpLocked ? "Unlock RSVP" : "Lock RSVP")</button>
                        }
                    </Authorized>
                </AuthorizeView>
            </section>

            <section class="rsvp-card overview-card">
                <h2>Workspaces</h2>
                <div class="overview-links">
                    <a href="/organizer/batches"><strong>Batch management</strong><span>Create, review, commit, and administer invitation waves.</span></a>
                    <a href="/organizer/parties"><strong>Parties</strong><span>Search, filter, correct, and override invitation parties.</span></a>
                    <a href="/organizer/settings"><strong>Event settings</strong><span>Review public event details and configuration.</span></a>
                </div>
            </section>
        </div>

        <section class="rsvp-card recent-activity">
            <div class="section-heading"><h2>Recent activity</h2><a href="/organizer/audit">View full audit history</a></div>
            @if (dashboard.Audits.Count == 0)
            {
                <p>No organizer activity has been recorded yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var audit in dashboard.Audits.Take(5))
                    {
                        <li><strong>@audit.EventType</strong> <span>@audit.Outcome by @audit.Actor, @audit.OccurredAtUtc.ToString("u")</span></li>
                    }
                </ul>
            }
        </section>
    }
</main>

@code {
    private OrganizerDashboard? dashboard;
    private bool confirmingLock;
    private string? actionError;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task ToggleLockAsync()
    {
        if (dashboard is null) return;
        try
        {
            await OrganizerService.SetGlobalLockAsync(!dashboard.IsRsvpLocked);
            confirmingLock = false;
            actionError = null;
            await RefreshAsync();
        }
        catch (InvalidOperationException exception)
        {
            actionError = exception.Message;
        }
    }

    private async Task RefreshAsync() => dashboard = await OrganizerService.GetDashboardAsync();
}
