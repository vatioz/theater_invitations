@page "/organizer"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using TheaterInvitations.Web.Services
@using TheaterInvitations.Domain
@using System.ComponentModel.DataAnnotations
@inject OrganizerService OrganizerService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Organizer</PageTitle>

<main class="organizer-page">
    <header>
        <p class="eyebrow">Organizer</p>
        <h1>Invitation administration</h1>
        <p>Development access: <a href="/dev/login/Viewer">Viewer</a> | <a href="/dev/login/Operator">Operator</a> | <a href="/dev/login/ElevatedOperator">Elevated operator</a> | <a href="/dev/logout">Sign out</a></p>
    </header>

    @if (dashboard is null)
    {
        <p>Loading invitation data...</p>
    }
    else
    {
        <section class="metrics" aria-label="Invitation metrics">
            <p><strong>@dashboard.ConfirmedSeats</strong> confirmed seats</p>
            <p><strong>@dashboard.ActivePendingSeats</strong> active pending seats</p>
            <p><strong>@dashboard.RemainingCapacity</strong> remaining seats</p>
            <p><strong>@dashboard.PartyCount</strong> parties</p>
        </section>

        <section class="rsvp-card">
            <h2>Global RSVP lock</h2>
            <p>Guest RSVP is currently <strong>@(dashboard.IsRsvpLocked ? "locked" : "open")</strong>.</p>
            <AuthorizeView Roles="ElevatedOperator">
                <Authorized>
                    @if (!confirmingLock)
                    {
                        <button @onclick="(() => confirmingLock = true)">@(dashboard.IsRsvpLocked ? "Unlock RSVP" : "Lock RSVP")</button>
                    }
                    else
                    {
                        <p class="notice">Confirm that you want to @(dashboard.IsRsvpLocked ? "unlock" : "lock") all guest RSVP changes.</p>
                        <button @onclick="ToggleLockAsync">Confirm</button> <button @onclick="(() => confirmingLock = false)">Cancel</button>
                    }
                </Authorized>
            </AuthorizeView>
        </section>

        <section class="rsvp-card">
            <h2>Import invitations</h2>
            <p>Upload CSV columns: <code>primary_guest_name,email,company,allocated_seats</code>.</p>
            <AuthorizeView Roles="Operator,ElevatedOperator">
                <Authorized>
                    <InputFile OnChange="PreviewAsync" accept=".csv,text/csv" />
                    @if (preview is not null)
                    {
                        <p>@preview.ValidRows.Count valid rows, @preview.Errors.Count invalid rows, @preview.TotalSeats seats.</p>
                        @foreach (var error in preview.Errors)
                        {
                            <p class="validation-message">@error</p>
                        }
                        @if (preview.IsValid)
                        {
                            <button @onclick="CommitAsync">Commit draft batch</button>
                        }
                    }
                </Authorized>
                <NotAuthorized><p>You have read-only access.</p></NotAuthorized>
            </AuthorizeView>
        </section>

        <section class="rsvp-card">
            <h2>Parties</h2>
            <EditForm Model="filters" OnValidSubmit="ApplyFiltersAsync" FormName="party-filters">
                <InputText @bind-Value="filters.Search" placeholder="Search name, email, or company" />
                <InputSelect @bind-Value="filters.Status">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<InvitationStatus>()) { <option value="@status">@status</option> }
                </InputSelect>
                <button type="submit">Filter</button>
            </EditForm>
            <div class="party-grid-wrap">
            <QuickGrid TGridItem="OrganizerParty" @ref="partyGrid" ItemsProvider="ProvideParties" Pagination="pagination" Class="party-grid">
                <PropertyColumn Property="party => party.Name" Title="Name" Sortable="true" IsDefaultSortColumn="true" />
                <PropertyColumn Property="party => party.Email" Title="Email" Sortable="true" />
                <PropertyColumn Property="party => party.Company" Title="Company" Sortable="true" />
                <PropertyColumn Property="party => party.AllocatedSeats" Title="Seats" Sortable="true" />
                <PropertyColumn Property="party => party.Status" Title="Status" Sortable="true" />
                <PropertyColumn Property="party => party.BatchName" Title="Batch" Sortable="true" />
                <TemplateColumn Context="party">
                    <AuthorizeView Roles="Operator,ElevatedOperator"><Authorized><button @onclick="(() => SelectParty(party))">Manage</button></Authorized></AuthorizeView>
                </TemplateColumn>
            </QuickGrid>
            </div>
            <Paginator State="pagination" />
        </section>

        @if (selectedParty is not null)
        {
            <section class="rsvp-card manage-party">
                <div class="manage-heading">
                    <div><p class="eyebrow">Party administration</p><h2>Manage @selectedParty.Name</h2></div>
                    <button type="button" class="button-secondary" @onclick="CloseManage">Close</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(actionError)) { <p class="validation-message">@actionError</p> }
                <div class="manage-actions">
                <AuthorizeView Roles="Operator,ElevatedOperator" Context="operatorAuth">
                    <Authorized>
                        <EditForm Model="correction" OnValidSubmit="CorrectAsync" FormName="party-correction" class="manage-form">
                            <h3>Correct details</h3>
                            <p>Update the party's contact information or seat allocation.</p>
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <label>Name <InputText @bind-Value="correction.Name" /> <ValidationMessage For="@(() => correction.Name)" /></label>
                            <label>Email <InputText @bind-Value="correction.Email" /> <ValidationMessage For="@(() => correction.Email)" /></label>
                            <label>Company <InputText @bind-Value="correction.Company" /></label>
                            <label>Allocated seats <InputNumber @bind-Value="correction.Seats" /> <ValidationMessage For="@(() => correction.Seats)" /></label>
                            <div class="form-actions"><button type="submit">Save correction</button> <button type="button" class="button-secondary" @onclick="CloseManage">Cancel</button></div>
                        </EditForm>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="ElevatedOperator" Context="elevatedAuth">
                    <Authorized>
                        <EditForm Model="overrideModel" OnValidSubmit="OverrideAsync" FormName="party-override" class="manage-form manage-form-warning">
                            <h3>Override status</h3>
                            <p>Apply an exceptional status change. A reason is required for the audit trail.</p>
                            <label>Status <InputSelect @bind-Value="overrideModel.Status">@foreach (var status in Enum.GetValues<InvitationStatus>()) { <option value="@status">@status</option> }</InputSelect></label>
                            <label>Reason <InputText @bind-Value="overrideModel.Reason" /></label>
                            <div class="form-actions"><button type="submit">Apply override</button> <button type="button" class="button-secondary" @onclick="CloseManage">Cancel</button></div>
                        </EditForm>
                    </Authorized>
                </AuthorizeView>
                </div>
            </section>
        }

        <section class="rsvp-card">
            <h2>Audit history</h2>
            <div class="party-grid-wrap">
                <QuickGrid TGridItem="OrganizerAudit" ItemsProvider="ProvideAudits" Pagination="auditPagination" Class="party-grid audit-grid">
                    <PropertyColumn Property="audit => audit.OccurredAtUtc" Title="When (UTC)" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending" />
                    <PropertyColumn Property="audit => audit.EventType" Title="Event" Sortable="true" />
                    <PropertyColumn Property="audit => audit.Outcome" Title="Outcome" Sortable="true" />
                    <PropertyColumn Property="audit => audit.Actor" Title="Actor" Sortable="true" />
                </QuickGrid>
            </div>
            <Paginator State="auditPagination" />
        </section>
    }
</main>

@code {
    private OrganizerDashboard? dashboard;
    private ImportPreview? preview;
    private readonly PartyFilters filters = new();
    private readonly PaginationState pagination = new() { ItemsPerPage = 25 };
    private readonly PaginationState auditPagination = new() { ItemsPerPage = 25 };
    private QuickGrid<OrganizerParty>? partyGrid;
    private OrganizerParty? selectedParty;
    private readonly CorrectionModel correction = new();
    private readonly OverrideModel overrideModel = new();
    private bool confirmingLock;
    private string? actionError;

    protected override async Task OnInitializedAsync() => await RefreshDashboardAsync();

    private async Task PreviewAsync(InputFileChangeEventArgs args)
    {
        await RequireRoleAsync("Operator", "ElevatedOperator");
        await using var stream = args.File.OpenReadStream(1_000_000);
        using var reader = new StreamReader(stream);
        preview = await OrganizerService.PreviewImportAsync(await reader.ReadToEndAsync());
    }

    private async Task CommitAsync()
    {
        await RequireRoleAsync("Operator", "ElevatedOperator");
        if (preview is not null)
        {
            await OrganizerService.CommitImportAsync(preview, "Imported batch");
            preview = null;
            await RefreshDashboardAsync();
        }
    }

    private async Task ToggleLockAsync()
    {
        await RequireRoleAsync("ElevatedOperator");
        if (dashboard is not null)
        {
            await OrganizerService.SetGlobalLockAsync(!dashboard.IsRsvpLocked);
            confirmingLock = false;
            await RefreshDashboardAsync();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        await pagination.SetCurrentPageIndexAsync(0);
        if (partyGrid is not null) await partyGrid.RefreshDataAsync();
    }

    private async Task RefreshDashboardAsync()
    {
        dashboard = await OrganizerService.GetDashboardAsync();
        if (partyGrid is not null) await partyGrid.RefreshDataAsync();
    }

    private ValueTask<GridItemsProviderResult<OrganizerParty>> ProvideParties(GridItemsProviderRequest<OrganizerParty> request) =>
        OrganizerService.GetPartiesAsync(request, filters.Search, filters.Status);

    private ValueTask<GridItemsProviderResult<OrganizerAudit>> ProvideAudits(GridItemsProviderRequest<OrganizerAudit> request) =>
        OrganizerService.GetAuditsAsync(request);

    private void SelectParty(OrganizerParty party)
    {
        selectedParty = party;
        correction.Name = party.Name; correction.Email = party.Email; correction.Company = party.Company; correction.Seats = party.AllocatedSeats;
        overrideModel.Status = party.Status; overrideModel.Reason = string.Empty; actionError = null;
    }

    private async Task CorrectAsync()
    {
        await RequireRoleAsync("Operator", "ElevatedOperator");
        try { await OrganizerService.CorrectPartyAsync(selectedParty!.Id, correction.Name, correction.Email, correction.Company, correction.Seats, await ActorAsync()); CloseManage(); await RefreshDashboardAsync(); }
        catch (ArgumentException exception) { actionError = exception.Message; }
        catch (InvalidOperationException exception) { actionError = exception.Message; }
    }

    private async Task OverrideAsync()
    {
        await RequireRoleAsync("ElevatedOperator");
        try { await OrganizerService.OverrideStatusAsync(selectedParty!.Id, overrideModel.Status, overrideModel.Reason, await ActorAsync()); CloseManage(); await RefreshDashboardAsync(); }
        catch (ArgumentException exception) { actionError = exception.Message; }
        catch (InvalidOperationException exception) { actionError = exception.Message; }
    }

    private async Task<string> ActorAsync() => (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "Organizer";

    private void CloseManage()
    {
        selectedParty = null;
        actionError = null;
    }

    private async Task RequireRoleAsync(params string[] roles)
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (!roles.Any(user.IsInRole))
        {
            throw new UnauthorizedAccessException();
        }
    }

    private sealed class PartyFilters { public string? Search { get; set; } public InvitationStatus? Status { get; set; } }
    private sealed class CorrectionModel
    {
        [Required] public string Name { get; set; } = string.Empty;
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        public string? Company { get; set; }
        [Range(1, int.MaxValue)] public int Seats { get; set; }
    }
    private sealed class OverrideModel { public InvitationStatus Status { get; set; } public string Reason { get; set; } = string.Empty; }
}
