@page "/organizer"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using TheaterInvitations.Web.Services
@inject OrganizerService OrganizerService

<PageTitle>Přehled pořadatele</PageTitle>

<main class="organizer-page">
    <header>
        <p class="eyebrow">Pořadatel</p>
        <h1>Správa pozvánek</h1>
        <p><a href="/account/logout">Odhlásit se</a></p>
        <OrganizerNavigation />
    </header>

    @if (dashboard is null)
    {
            <p>Načítání údajů o pozvánkách...</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(actionError))
        {
            <p class="validation-message" role="alert">@actionError</p>
        }
        <section class="metrics" aria-label="Přehled pozvánek">
            <p><strong>@dashboard.ConfirmedSeats</strong> potvrzených míst</p>
            <p><strong>@dashboard.ActivePendingSeats</strong> míst čekajících na odpověď</p>
            <p><strong>@dashboard.RemainingCapacity</strong> zbývajících míst</p>
            <p><strong>@dashboard.PartyCount</strong> skupin</p>
        </section>

        <div class="overview-grid">
            <section class="rsvp-card overview-card">
                <h2>Stav potvrzování účasti</h2>
                <p>Potvrzování účasti hostů je nyní <strong>@(dashboard.IsRsvpLocked ? "uzavřeno" : "otevřeno")</strong>.</p>
                @if (dashboard.Configuration is null)
                {
                    <p class="validation-message">Nastavení akce není úplné. Potvrzování účasti není dostupné.</p>
                }
                else
                {
                    <p>Podpora: @(string.IsNullOrWhiteSpace(dashboard.Configuration.SupportEmail) ? "nenastavena" : dashboard.Configuration.SupportEmail).</p>
                }
                <AuthorizeView Roles="ElevatedOperator" Context="lockAuth">
                    <Authorized>
                        @if (confirmingLock)
                        {
                            <p class="notice">Potvrďte, že chcete @(dashboard.IsRsvpLocked ? "otevřít" : "uzavřít") všechny změny odpovědí hostů.</p>
                            <button @onclick="ToggleLockAsync">Potvrdit</button> <button class="button-secondary" @onclick="(() => confirmingLock = false)">Zrušit</button>
                        }
                        else
                        {
                            <button @onclick="(() => confirmingLock = true)">@(dashboard.IsRsvpLocked ? "Otevřít potvrzování účasti" : "Uzavřít potvrzování účasti")</button>
                        }
                    </Authorized>
                </AuthorizeView>
            </section>

            <section class="rsvp-card overview-card">
                <h2>Pracovní oblasti</h2>
                <div class="overview-links">
                    <a href="/organizer/batches"><strong>Správa dávek</strong><span>Vytvářejte, kontrolujte, potvrzujte a spravujte vlny pozvánek.</span></a>
                    <a href="/organizer/parties"><strong>Skupiny</strong><span>Vyhledávejte, filtrujte, opravujte a měňte stav skupin.</span></a>
                    <a href="/organizer/settings"><strong>Nastavení akce</strong><span>Kontrolujte veřejné údaje o akci a konfiguraci.</span></a>
                </div>
            </section>
        </div>

        <section class="rsvp-card recent-activity">
            <div class="section-heading"><h2>Nedávná aktivita</h2><a href="/organizer/audit">Zobrazit celou historii změn</a></div>
            @if (dashboard.Audits.Count == 0)
            {
                <p>Zatím nebyla zaznamenána žádná aktivita pořadatele.</p>
            }
            else
            {
                <ul>
                    @foreach (var audit in dashboard.Audits.Take(5))
                    {
                        <li><strong>@audit.EventType</strong> <span>@audit.Outcome, @audit.Actor, @audit.OccurredAtUtc.ToString("g", CzechPresentationFormatter.Culture)</span></li>
                    }
                </ul>
            }
        </section>
    }
</main>

@code {
    private OrganizerDashboard? dashboard;
    private bool confirmingLock;
    private string? actionError;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task ToggleLockAsync()
    {
        if (dashboard is null) return;
        try
        {
            await OrganizerService.SetGlobalLockAsync(!dashboard.IsRsvpLocked);
            confirmingLock = false;
            actionError = null;
            await RefreshAsync();
        }
        catch (InvalidOperationException exception)
        {
            actionError = exception.Message;
        }
    }

    private async Task RefreshAsync() => dashboard = await OrganizerService.GetDashboardAsync();
}
