@page "/rsvp/{Token}"
@rendermode InteractiveServer
@using TheaterInvitations.Domain
@using TheaterInvitations.Web.Services
@using Microsoft.EntityFrameworkCore
@inject RsvpInvitationService InvitationService
@inject RsvpService RsvpService

<PageTitle>Potvrzení účasti</PageTitle>

<main class="rsvp-page">
    @if (invitation is null)
    {
        <section class="rsvp-card" aria-labelledby="invalid-link-heading">
            <h1 id="invalid-link-heading">Odkaz pro potvrzení účasti není dostupný</h1>
            <p>Odkaz může být neplatný, jeho platnost mohla skončit nebo už není aktivní. Obraťte se prosím na pořadatele akce.</p>
        </section>
    }
    else if (!invitation.IsConfigurationAvailable)
    {
        <UnavailableView Heading="Potvrzení účasti je dočasně nedostupné" Invitation="invitation" />
    }
    else if (invitation.IsLocked && !invitation.HasRecordedResponse)
    {
        <UnavailableView Heading="Odpovědi na pozvání jsou uzavřeny" Invitation="invitation" />
    }
    else if (invitation.IsExpired && !invitation.HasRecordedResponse)
    {
        <UnavailableView Heading="Termín pro potvrzení účasti vypršel" Invitation="invitation" />
    }
    else if (submitted || (invitation.HasRecordedResponse && (!editing || !invitation.CanRespond)))
    {
        <section class="rsvp-card" aria-labelledby="recorded-heading">
            <p class="eyebrow">Odpověď zaznamenána</p>
            <h1 id="recorded-heading">Děkujeme, @invitation.PrimaryGuestName</h1>
            <p>@StatusMessage()</p>
            <p>Pozvání zahrnuje @SeatDescription(invitation.AllocatedSeats).</p>
            @if (invitation.HasEventDetails) { <EventDetails Invitation="invitation" /> }
            @if (!submitted && invitation.CanRespond)
            {
                <button type="button" @onclick="BeginEditing">Upravit odpověď</button>
            }
        </section>
    }
    else
    {
        <section class="rsvp-card" aria-labelledby="rsvp-heading">
            <p class="eyebrow">Pozvání do divadla</p>
            @if (invitation.HasEventDetails)
            {
                <h1 id="rsvp-heading">@invitation.EventName</h1>
                <h2 class="guest-heading">@invitation.PrimaryGuestName</h2>
            }
            else
            {
                <h1 id="rsvp-heading">Potvrzení účasti pro @invitation.PrimaryGuestName</h1>
            }
            <p>Pozvání zahrnuje @SeatDescription(invitation.AllocatedSeats).</p>
            @if (invitation.AllocatedSeats > 1)
            {
                <p class="notice">Vaše odpověď potvrzuje nebo odmítá celou rezervaci pro skupinu.</p>
            }
            <p class="deadline">Odpovězte prosím do <strong>@FormatDeadline(invitation)</strong>.</p>
            @if (invitation.HasEventDetails) { <EventDetails Invitation="invitation" ShowEventName="false" /> }

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="validation-message" role="alert">@error</p>
                @if (showSupportContact)
                {
                    <SupportContact Invitation="invitation" />
                }
            }

            <fieldset disabled="@submitting" class="rsvp-actions">
                <legend>Vaše odpověď</legend>
                <div class="response-actions">
                    <button type="button" @onclick="(() => SubmitAsync(RsvpResponse.Confirm))">@(submitting ? "Ukládání..." : "Potvrdit účast")</button>
                    <button type="button" class="button-secondary" @onclick="BeginDecline" disabled="@submitting">Odmítnout účast</button>
                </div>
                @if (showAccessibilityField)
                {
                    <div class="accessibility-request">
                        <label for="accessibility">Jakou podporu potřebujete pro svou skupinu?</label>
                        <p id="accessibility-help">Toto pole vyplňte pouze, pokud potřebujete zajistit přístupnost nebo jinou podporu. Maximum @invitation.AccessibilityTextLimit znaků.</p>
                        <InputTextArea id="accessibility" @bind-Value="model.AccessibilityRequirements" maxlength="@invitation.AccessibilityTextLimit" aria-describedby="accessibility-help" />
                    </div>
                }
                else
                {
                    <button type="button" class="accessibility-toggle" @onclick="ShowAccessibilityField" disabled="@submitting">Potřebuji zajistit přístupnost nebo jinou podporu</button>
                }
                @if (confirmingDecline)
                {
                    <div class="decline-confirmation" role="alert" tabindex="-1">
                        <p>Opravdu chcete odmítnout účast celé skupiny?</p>
                        <button type="button" @onclick="(() => SubmitAsync(RsvpResponse.Decline))">Ano, odmítnout účast</button>
                        <button type="button" class="button-secondary" @onclick="CancelDecline" disabled="@submitting">Zrušit</button>
                    </div>
                }
            </fieldset>
        </section>
    }
</main>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private RsvpInvitation? invitation;
    private readonly RsvpModel model = new();
    private bool submitting;
    private bool submitted;
    private bool editing;
    private bool confirmingDecline;
    private bool showAccessibilityField;
    private bool showSupportContact;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        invitation = await InvitationService.GetAsync(Token);
        if (invitation is not null && invitation.Status is InvitationStatus.Confirmed or InvitationStatus.Declined)
        {
            model.Response = invitation.Status == InvitationStatus.Confirmed ? RsvpResponse.Confirm : RsvpResponse.Decline;
            model.AccessibilityRequirements = invitation.AccessibilityRequirements;
            showAccessibilityField = !string.IsNullOrWhiteSpace(model.AccessibilityRequirements);
        }
    }

    private void BeginEditing()
    {
        if (invitation is not null)
        {
            model.Response = invitation.Status == InvitationStatus.Confirmed ? RsvpResponse.Confirm : RsvpResponse.Decline;
            model.AccessibilityRequirements = invitation.AccessibilityRequirements;
            showAccessibilityField = !string.IsNullOrWhiteSpace(model.AccessibilityRequirements);
        }

        editing = true;
        submitted = false;
        confirmingDecline = false;
    }

    private void BeginDecline() => confirmingDecline = true;

    private void CancelDecline() => confirmingDecline = false;

    private void ShowAccessibilityField() => showAccessibilityField = true;

    private async Task SubmitAsync(RsvpResponse response)
    {
        submitting = true;
        error = null;
        showSupportContact = false;
        try
        {
            model.Response = response;
            var accessibilityRequirements = response == RsvpResponse.Confirm ? model.AccessibilityRequirements : null;
            var result = await RsvpService.SubmitAsync(Token, new RsvpSubmission(response, accessibilityRequirements, invitation?.Version), Guid.NewGuid().ToString("N"));
            invitation = await InvitationService.GetAsync(Token);
            if (!result.IsValidToken || result.Result is RsvpResult.Locked or RsvpResult.Expired or RsvpResult.CapacityExceeded or RsvpResult.Stale)
            {
                error = result.Result switch
                {
                    RsvpResult.CapacityExceeded => "Potvrzení se nepodařilo zaznamenat, protože už nejsou volná místa.",
                    RsvpResult.Stale => "Tato odpověď byla změněna v jiné relaci. Je zobrazena aktuální odpověď; před dalším pokusem ji zkontrolujte.",
                    _ => "Potvrzení účasti už není dostupné."
                };
                showSupportContact = result.Result == RsvpResult.CapacityExceeded;
                return;
            }

            submitted = true;
            editing = false;
            confirmingDecline = false;
        }
        catch (ArgumentException)
        {
            error = "Zkraťte prosím požadavky na přístupnost a zkuste to znovu.";
        }
        catch (TransactionConflictException exception)
        {
            error = exception.Message;
            showSupportContact = true;
            invitation = await InvitationService.GetAsync(Token);
        }
        catch (DbUpdateException)
        {
            error = "Odpověď se nepodařilo uložit. Můžete to bezpečně zkusit znovu.";
            showSupportContact = true;
            invitation = await InvitationService.GetAsync(Token);
        }
        finally
        {
            submitting = false;
        }
    }

    private static string SeatDescription(int seats) => CzechPresentationFormatter.Seats(seats);

    private string StatusMessage() => model.Response == RsvpResponse.Confirm
        ? "Účast vaší skupiny je potvrzena."
        : "Účast vaší skupiny byla odmítnuta.";

    private static string FormatDeadline(RsvpInvitation invitation)
    {
        var timeZone = TimeZoneInfo.FindSystemTimeZoneById(invitation.TimeZoneId);
        return CzechPresentationFormatter.FormatPublicDateTime(invitation.DeadlineUtc, timeZone);
    }

    private sealed class RsvpModel
    {
        public RsvpResponse Response { get; set; } = RsvpResponse.Confirm;
        public string? AccessibilityRequirements { get; set; }
    }
}
