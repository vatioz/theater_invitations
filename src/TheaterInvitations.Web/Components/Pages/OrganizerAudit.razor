@page "/organizer/audit"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using TheaterInvitations.Web.Services
@using OrganizerAuditRow = TheaterInvitations.Web.Services.OrganizerAudit
@inject OrganizerService OrganizerService

<PageTitle>Historie změn</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Pořadatel</p><h1>Historie změn</h1><OrganizerNavigation /></header>
    <section class="rsvp-card audit-page-card">
        <p>Prohlédněte si zaznamenané kroky pořadatelů a hostů. Citlivé RSVP tokeny a text požadavků na přístupnost zde nejsou zobrazeny.</p>
        <div class="party-grid-wrap"><QuickGrid TGridItem="OrganizerAuditRow" ItemsProvider="ProvideAudits" Pagination="pagination" Class="party-grid audit-grid"><PropertyColumn Property="audit => audit.OccurredAtUtc" Title="Kdy (UTC)" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending" /><PropertyColumn Property="audit => audit.EventType" Title="Událost" Sortable="true" /><PropertyColumn Property="audit => audit.Outcome" Title="Výsledek" Sortable="true" /><PropertyColumn Property="audit => audit.Actor" Title="Aktér" Sortable="true" /></QuickGrid></div>
        <Paginator State="pagination" />
    </section>
</main>
@code { private readonly PaginationState pagination = new() { ItemsPerPage = 25 }; private ValueTask<GridItemsProviderResult<OrganizerAuditRow>> ProvideAudits(GridItemsProviderRequest<OrganizerAuditRow> request) => OrganizerService.GetAuditsAsync(request); }
