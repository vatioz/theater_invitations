@page "/organizer/parties"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.QuickGrid
@using TheaterInvitations.Domain
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject OrganizerService OrganizerService
@inject EmailCampaignService EmailCampaignService

<PageTitle>Skupiny pozvaných</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Pořadatel</p><h1>Skupiny pozvaných</h1><OrganizerNavigation /></header>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
    <section class="rsvp-card parties-page-card">
        <div class="section-heading"><div><h2>Seznam skupin</h2><p>Vyhledejte a filtrujte aktuální seznam pozvaných.</p></div></div>
        <EditForm Model="filters" OnValidSubmit="ApplyFiltersAsync" FormName="party-filters" class="party-filter-form"><InputText @bind-Value="filters.Search" placeholder="Hledat jméno, e-mail nebo společnost" /><InputSelect @bind-Value="filters.Status"><option value="">Všechny stavy</option>@foreach (var status in Enum.GetValues<InvitationStatus>()) { <option value="@status">@CzechPresentationFormatter.DisplayInvitationStatus(status)</option> }</InputSelect><InputSelect @bind-Value="filters.BatchId"><option value="">Všechny dávky</option>@foreach (var batch in batches) { <option value="@batch.Id">@batch.Name</option> }</InputSelect><button type="submit">Filtrovat</button></EditForm>
        <div class="party-grid-wrap"><QuickGrid TGridItem="OrganizerParty" @ref="grid" ItemsProvider="ProvideParties" Pagination="pagination" Class="party-grid"><PropertyColumn Property="party => party.Name" Title="Jméno" Sortable="true" IsDefaultSortColumn="true" /><PropertyColumn Property="party => party.Email" Title="E-mail" Sortable="true" /><PropertyColumn Property="party => party.Company" Title="Společnost" Sortable="true" /><TemplateColumn Context="party" Title="Místa" SortBy="@(GridSort<OrganizerParty>.ByAscending(party => party.AllocatedSeats))">@CzechPresentationFormatter.Seats(party.AllocatedSeats)</TemplateColumn><TemplateColumn Context="party" Title="Stav" SortBy="@(GridSort<OrganizerParty>.ByAscending(party => party.Status))">@CzechPresentationFormatter.DisplayInvitationStatus(party.Status)</TemplateColumn><TemplateColumn Context="party" Title="E-mail" SortBy="@(GridSort<OrganizerParty>.ByAscending(party => party.LatestEmailState))">@CzechPresentationFormatter.DispatchState(party.LatestEmailState)</TemplateColumn><PropertyColumn Property="party => party.BatchName" Title="Dávka" Sortable="true" /><TemplateColumn Context="party"><AuthorizeView Roles="Operator,ElevatedOperator"><Authorized><button @onclick="(() => SelectPartyAsync(party))">Spravovat</button></Authorized></AuthorizeView></TemplateColumn></QuickGrid></div><Paginator State="pagination" />
    </section>
    @if (selected is not null)
    {
        <section class="rsvp-card manage-party"><div class="manage-heading"><div><p class="eyebrow">Správa skupiny</p><h2>Správa skupiny @selected.Name</h2></div><button class="button-secondary" @onclick="Close">Zavřít</button></div><div class="manage-actions"><AuthorizeView Roles="Operator,ElevatedOperator" Context="operatorAuth"><Authorized><EditForm Model="correction" OnValidSubmit="CorrectAsync" FormName="party-correction" class="manage-form"><h3>Opravit údaje</h3><DataAnnotationsValidator /><ValidationSummary /><label>Jméno <InputText @bind-Value="correction.Name" /></label><label>E-mail <InputText @bind-Value="correction.Email" /></label><label>Společnost <InputText @bind-Value="correction.Company" /></label><label>Počet míst <InputNumber @bind-Value="correction.Seats" /></label><div class="form-actions"><button type="submit">Uložit opravu</button><button type="button" class="button-secondary" @onclick="Close">Zrušit</button></div></EditForm><div class="email-resend"><h3>Odeslat pozvánku znovu</h3><p>Použije aktuální odkaz RSVP této skupiny.</p><InputSelect @bind-Value="resendTemplateId"><option value="">Vyberte aktivní šablonu pozvánky</option>@foreach (var template in approvedInvitationTemplates) { <option value="@template.Id">@template.Subject</option> }</InputSelect><button @onclick="PrepareResendAsync" disabled="@(resendTemplateId is null)">Připravit opětovné odeslání ke kontrole</button></div></Authorized></AuthorizeView><AuthorizeView Roles="ElevatedOperator" Context="elevatedAuth"><Authorized><EditForm Model="overrideModel" OnValidSubmit="OverrideAsync" FormName="party-override" class="manage-form manage-form-warning"><h3>Změnit stav výjimečně</h3><p>Proveďte mimořádnou změnu stavu. Pro auditní záznam je nutné uvést důvod.</p><label>Stav <InputSelect @bind-Value="overrideModel.Status">@foreach (var status in Enum.GetValues<InvitationStatus>()) { <option value="@status">@CzechPresentationFormatter.DisplayInvitationStatus(status)</option> }</InputSelect></label><label>Důvod <InputTextArea @bind-Value="overrideModel.Reason" /></label><button type="submit">Provést výjimečnou změnu</button></EditForm></Authorized><NotAuthorized><p>Stavy skupin mohou výjimečně měnit pouze uživatelé s rozšířeným oprávněním.</p></NotAuthorized></AuthorizeView><div class="dispatch-history"><h3>Historie odesílání e-mailů</h3>@if (emailDispatches.Count == 0) { <p>Pro tuto skupinu zatím nejsou zaznamenána žádná odeslání e-mailu.</p> } else { <ul>@foreach (var dispatch in emailDispatches) { <li>@dispatch.CampaignCreatedAtUtc.ToString("g", CzechPresentationFormatter.Culture): @CzechPresentationFormatter.DispatchState(dispatch.State) (@dispatch.AttemptCount pokusů)@(dispatch.FailureCategory is null ? string.Empty : $" - {dispatch.FailureCategory}")</li> }</ul> }</div></div></section>
    }
</main>
@code {
    private readonly PartyFilters filters = new(); private readonly PaginationState pagination = new() { ItemsPerPage = 25 }; private QuickGrid<OrganizerParty>? grid; private IReadOnlyList<OrganizerBatch> batches = Array.Empty<OrganizerBatch>(); private IReadOnlyList<EmailTemplateSummary> approvedInvitationTemplates = Array.Empty<EmailTemplateSummary>(); private IReadOnlyList<OrganizerEmailDispatch> emailDispatches = Array.Empty<OrganizerEmailDispatch>(); private Guid? resendTemplateId; private OrganizerParty? selected; private readonly CorrectionModel correction = new(); private readonly OverrideModel overrideModel = new(); private string? error;
    protected override async Task OnInitializedAsync() { batches = await OrganizerService.GetBatchesAsync(); approvedInvitationTemplates = (await EmailCampaignService.GetTemplatesAsync()).Where(x => x.Type == EmailTemplateType.InitialInvitation && x.State == EmailTemplateState.Active).Select(x => x with { Subject = x.Name }).ToList(); }
    private ValueTask<GridItemsProviderResult<OrganizerParty>> ProvideParties(GridItemsProviderRequest<OrganizerParty> request) => OrganizerService.GetPartiesAsync(request, filters.Search, filters.Status, filters.BatchId);
    private async Task ApplyFiltersAsync() { await pagination.SetCurrentPageIndexAsync(0); if (grid is not null) await grid.RefreshDataAsync(); }
    private async Task SelectPartyAsync(OrganizerParty party) { selected = party; correction.Name = party.Name; correction.Email = party.Email; correction.Company = party.Company; correction.Priority = party.Priority; correction.Phone = party.Phone; correction.Seats = party.AllocatedSeats; overrideModel.Status = party.Status; overrideModel.Reason = string.Empty; emailDispatches = await OrganizerService.GetPartyEmailDispatchesAsync(party.Id); error = null; }
    private async Task PrepareResendAsync() { if (selected is null || resendTemplateId is null) return; try { var campaign = await EmailCampaignService.PrepareResendCampaignAsync(selected.Id, resendTemplateId.Value); error = $"Kampaň pro opětovné odeslání je připravena. Zkontrolujte ji na /organizer/email/{campaign.Id}."; } catch (Exception exception) when (exception is InvalidOperationException or StaleDataException) { error = exception.Message; } }
    private async Task CorrectAsync() { if (selected is null) return; try { await OrganizerService.CorrectPartyAsync(selected.Id, selected.Version, correction.Name, correction.Email, correction.Company, correction.Priority, correction.Phone, correction.Seats); Close(); if (grid is not null) await grid.RefreshDataAsync(); } catch (Exception exception) when (exception is StaleDataException or ArgumentException or InvalidOperationException) { error = exception.Message; if (exception is StaleDataException) { selected = null; if (grid is not null) await grid.RefreshDataAsync(); } } }
    private async Task OverrideAsync() { if (selected is null) return; try { await OrganizerService.OverrideStatusAsync(selected.Id, selected.Version, overrideModel.Status, overrideModel.Reason); Close(); if (grid is not null) await grid.RefreshDataAsync(); } catch (Exception exception) when (exception is StaleDataException or ArgumentException or InvalidOperationException) { error = exception.Message; if (exception is StaleDataException) { selected = null; if (grid is not null) await grid.RefreshDataAsync(); } } }
    private void Close() { selected = null; emailDispatches = Array.Empty<OrganizerEmailDispatch>(); error = null; }
    private sealed class PartyFilters { public string? Search { get; set; } public InvitationStatus? Status { get; set; } public Guid? BatchId { get; set; } }
    private sealed class CorrectionModel { [Required] public string Name { get; set; } = string.Empty; [Required, EmailAddress] public string Email { get; set; } = string.Empty; public string? Company { get; set; } [Range(1, 3)] public int Priority { get; set; } = 3; public string? Phone { get; set; } [Range(1, int.MaxValue)] public int Seats { get; set; } }
    private sealed class OverrideModel { public InvitationStatus Status { get; set; } public string Reason { get; set; } = string.Empty; }
}
