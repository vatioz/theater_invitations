@page "/organizer/parties"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.QuickGrid
@using TheaterInvitations.Domain
@using TheaterInvitations.Web.Services
@inject OrganizerService OrganizerService

<PageTitle>Invitation parties</PageTitle>
<main class="organizer-page">
    <header><p class="eyebrow">Organizer</p><h1>Invitation parties</h1><OrganizerNavigation /></header>
    @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
    <section class="rsvp-card parties-page-card">
        <div class="section-heading"><div><h2>Party directory</h2><p>Search and filter the current invitation list.</p></div></div>
        <EditForm Model="filters" OnValidSubmit="ApplyFiltersAsync" FormName="party-filters" class="party-filter-form"><InputText @bind-Value="filters.Search" placeholder="Search name, email, or company" /><InputSelect @bind-Value="filters.Status"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<InvitationStatus>()) { <option value="@status">@status</option> }</InputSelect><InputSelect @bind-Value="filters.BatchId"><option value="">All batches</option>@foreach (var batch in batches) { <option value="@batch.Id">@batch.Name</option> }</InputSelect><button type="submit">Filter</button></EditForm>
        <div class="party-grid-wrap"><QuickGrid TGridItem="OrganizerParty" @ref="grid" ItemsProvider="ProvideParties" Pagination="pagination" Class="party-grid"><PropertyColumn Property="party => party.Name" Title="Name" Sortable="true" IsDefaultSortColumn="true" /><PropertyColumn Property="party => party.Email" Title="Email" Sortable="true" /><PropertyColumn Property="party => party.Company" Title="Company" Sortable="true" /><PropertyColumn Property="party => party.AllocatedSeats" Title="Seats" Sortable="true" /><PropertyColumn Property="party => party.Status" Title="Status" Sortable="true" /><PropertyColumn Property="party => party.LatestEmailState" Title="Email" Sortable="true" /><PropertyColumn Property="party => party.BatchName" Title="Batch" Sortable="true" /><TemplateColumn Context="party"><AuthorizeView Roles="Operator,ElevatedOperator"><Authorized><button @onclick="(() => SelectPartyAsync(party))">Manage</button></Authorized></AuthorizeView></TemplateColumn></QuickGrid></div><Paginator State="pagination" />
    </section>
    @if (selected is not null)
    {
        <section class="rsvp-card manage-party"><div class="manage-heading"><div><p class="eyebrow">Party administration</p><h2>Manage @selected.Name</h2></div><button class="button-secondary" @onclick="Close">Close</button></div><div class="manage-actions"><AuthorizeView Roles="Operator,ElevatedOperator" Context="operatorAuth"><Authorized><EditForm Model="correction" OnValidSubmit="CorrectAsync" FormName="party-correction" class="manage-form"><h3>Correct details</h3><DataAnnotationsValidator /><ValidationSummary /><label>Name <InputText @bind-Value="correction.Name" /></label><label>Email <InputText @bind-Value="correction.Email" /></label><label>Company <InputText @bind-Value="correction.Company" /></label><label>Allocated seats <InputNumber @bind-Value="correction.Seats" /></label><div class="form-actions"><button type="submit">Save correction</button><button type="button" class="button-secondary" @onclick="Close">Cancel</button></div></EditForm></Authorized></AuthorizeView><AuthorizeView Roles="ElevatedOperator" Context="elevatedAuth"><Authorized><EditForm Model="overrideModel" OnValidSubmit="OverrideAsync" FormName="party-override" class="manage-form manage-form-warning"><h3>Override status</h3><p>Apply an exceptional status change. A reason is required for the audit trail.</p><label>Status <InputSelect @bind-Value="overrideModel.Status">@foreach (var status in Enum.GetValues<InvitationStatus>()) { <option value="@status">@status</option> }</InputSelect></label><label>Reason <InputText @bind-Value="overrideModel.Reason" /></label><div class="form-actions"><button type="submit">Apply override</button><button type="button" class="button-secondary" @onclick="Close">Cancel</button></div></EditForm></Authorized></AuthorizeView></div><div class="email-history"><h3>Email history</h3>@if (emailDispatches.Count == 0) { <p>No invitation email has been prepared for this party.</p> } else { <table><thead><tr><th>Campaign</th><th>State</th><th>Attempts</th><th>Accepted</th><th>Failure</th></tr></thead><tbody>@foreach (var dispatch in emailDispatches) { <tr><td>@dispatch.CampaignType for @dispatch.BatchName</td><td>@dispatch.State</td><td>@dispatch.AttemptCount</td><td>@(dispatch.AcceptedAtUtc?.ToString("u") ?? "-")</td><td>@(dispatch.FailureCategory ?? "-")</td></tr> }</tbody></table> }</div></section>
    }
</main>
@code {
    private readonly PartyFilters filters = new(); private readonly PaginationState pagination = new() { ItemsPerPage = 25 }; private QuickGrid<OrganizerParty>? grid; private IReadOnlyList<OrganizerBatch> batches = Array.Empty<OrganizerBatch>(); private IReadOnlyList<OrganizerEmailDispatch> emailDispatches = Array.Empty<OrganizerEmailDispatch>(); private OrganizerParty? selected; private readonly CorrectionModel correction = new(); private readonly OverrideModel overrideModel = new(); private string? error;
    protected override async Task OnInitializedAsync() => batches = await OrganizerService.GetBatchesAsync();
    private ValueTask<GridItemsProviderResult<OrganizerParty>> ProvideParties(GridItemsProviderRequest<OrganizerParty> request) => OrganizerService.GetPartiesAsync(request, filters.Search, filters.Status, filters.BatchId);
    private async Task ApplyFiltersAsync() { await pagination.SetCurrentPageIndexAsync(0); if (grid is not null) await grid.RefreshDataAsync(); }
    private async Task SelectPartyAsync(OrganizerParty party) { selected = party; correction.Name = party.Name; correction.Email = party.Email; correction.Company = party.Company; correction.Seats = party.AllocatedSeats; overrideModel.Status = party.Status; overrideModel.Reason = string.Empty; emailDispatches = await OrganizerService.GetPartyEmailDispatchesAsync(party.Id); error = null; }
    private async Task CorrectAsync() { if (selected is null) return; try { await OrganizerService.CorrectPartyAsync(selected.Id, selected.Version, correction.Name, correction.Email, correction.Company, correction.Seats); Close(); if (grid is not null) await grid.RefreshDataAsync(); } catch (Exception exception) when (exception is StaleDataException or ArgumentException or InvalidOperationException) { error = exception.Message; if (exception is StaleDataException) { selected = null; if (grid is not null) await grid.RefreshDataAsync(); } } }
    private async Task OverrideAsync() { if (selected is null) return; try { await OrganizerService.OverrideStatusAsync(selected.Id, selected.Version, overrideModel.Status, overrideModel.Reason); Close(); if (grid is not null) await grid.RefreshDataAsync(); } catch (Exception exception) when (exception is StaleDataException or ArgumentException or InvalidOperationException) { error = exception.Message; if (exception is StaleDataException) { selected = null; if (grid is not null) await grid.RefreshDataAsync(); } } }
    private void Close() { selected = null; emailDispatches = Array.Empty<OrganizerEmailDispatch>(); error = null; }
    private sealed class PartyFilters { public string? Search { get; set; } public InvitationStatus? Status { get; set; } public Guid? BatchId { get; set; } }
    private sealed class CorrectionModel { [Required] public string Name { get; set; } = string.Empty; [Required, EmailAddress] public string Email { get; set; } = string.Empty; public string? Company { get; set; } [Range(1, int.MaxValue)] public int Seats { get; set; } }
    private sealed class OverrideModel { public InvitationStatus Status { get; set; } public string Reason { get; set; } = string.Empty; }
}
