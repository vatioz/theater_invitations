@page "/organizer/settings"
@attribute [Authorize(Policy = "OrganizerViewer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TheaterInvitations.Web.Data
@using TheaterInvitations.Web.Services
@inject OrganizerService OrganizerService
@inject EmailCampaignService EmailCampaignService

<PageTitle>Nastavení akce</PageTitle>

<main class="organizer-page">
    <header><p class="eyebrow">Pořadatel</p><h1>Nastavení akce</h1><OrganizerNavigation /></header>
    @if (dashboard is null) { <p>Načítání nastavení akce...</p> }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error)) { <p class="validation-message" role="alert">@error</p> }
        <section class="rsvp-card settings-card">
            <h2>Veřejné nastavení akce</h2>
            @if (dashboard.Configuration is null) { <p>Nastavení akce ještě nebylo vytvořeno. Potvrzování účasti zůstane nedostupné, dokud je rozšířený operátor neuloží.</p> }
            else
            {
                <dl class="configuration-summary">
                    <div><dt>Akce</dt><dd>@dashboard.Configuration.EventName</dd></div>
                    <div><dt>Místo</dt><dd>@dashboard.Configuration.VenueName</dd></div>
                    <div><dt>Podpora</dt><dd>@(string.IsNullOrWhiteSpace(dashboard.Configuration.SupportEmail) ? "Nenastavena" : dashboard.Configuration.SupportEmail)</dd></div>
                    <div><dt>Časové pásmo</dt><dd>@dashboard.Configuration.TimeZoneId</dd></div>
                </dl>
            }
            <AuthorizeView Roles="ElevatedOperator" Context="settingsAuth">
                <Authorized>
                    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="event-configuration" class="manage-form settings-form">
                        <DataAnnotationsValidator /><ValidationSummary />
                        <label>Název akce <InputText @bind-Value="model.EventName" /></label>
                        <label>Časové pásmo akce <InputText @bind-Value="model.TimeZoneId" /></label>
                        <label>Čas otevření <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="model.DoorsLocal" /></label>
                        <label>Čas začátku <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="model.StartsLocal" /></label>
                        <label>Název místa <InputText @bind-Value="model.VenueName" /></label>
                        <label>Adresa místa <InputTextArea @bind-Value="model.VenueAddress" /></label>
                        <label>Dress code (nepovinné) <InputText @bind-Value="model.DressCode" /></label>
                        <label>E-mail podpory (nepovinné) <InputText @bind-Value="model.SupportEmail" /></label>
                        <label>Kapacita <InputNumber @bind-Value="model.Capacity" /></label>
                        <label>Limit znaků požadavku na přístupnost <InputNumber @bind-Value="model.AccessibilityTextLimit" /></label>
                        <button type="submit">Uložit nastavení akce</button>
                    </EditForm>
                </Authorized>
                <NotAuthorized><p>K nastavení akce máte přístup pouze pro čtení.</p></NotAuthorized>
            </AuthorizeView>
        </section>
        <section class="rsvp-card settings-card">
            <h2>Nastavení odesílatele e-mailů</h2>
            <p>Nastavte společnou adresu odesílatele a adresu pro odpovědi. Zobrazované jméno se nastavuje u každé šablony. Klíč Resend API zůstává chráněným tajemstvím nasazení a zde se nezobrazuje.</p>
            <AuthorizeView Roles="ElevatedOperator" Context="emailSettingsAuth">
                <Authorized>
                    <EditForm Model="emailModel" OnValidSubmit="SaveEmailSettingsAsync" FormName="email-sender-settings" class="manage-form settings-form">
                        <DataAnnotationsValidator /><ValidationSummary />
                        <label>Adresa odesílatele <InputText @bind-Value="emailModel.FromAddress" /></label>
                        <label>Adresa pro odpovědi <InputText @bind-Value="emailModel.ReplyToAddress" /></label>
                        <label>Denní limit odesílání <InputNumber @bind-Value="emailModel.DailySendCeiling" /></label>
                        <label class="checkbox-label"><InputCheckbox @bind-Value="emailModel.IsDomainVerified" /> Ověřil(a) jsem tuto doménu odesílatele v Resend.</label>
                        <button type="submit">Uložit nastavení odesílatele</button>
                    </EditForm>
                </Authorized>
                <NotAuthorized>
                    @if (emailSettings is null) { <p>Nastavení odesílatele není vytvořeno.</p> }
                    else { <p>Adresa odesílatele: @emailSettings.FromAddress, odpovědi: @emailSettings.ReplyToAddress, denní limit: @emailSettings.DailySendCeiling.</p> }
                </NotAuthorized>
            </AuthorizeView>
            <AuthorizeView Roles="ElevatedOperator" Context="usersLinkAuth"><Authorized><p><a href="/organizer/users">Spravovat účty pořadatelů</a></p></Authorized></AuthorizeView>
        </section>
    }
</main>

@code {
    private OrganizerDashboard? dashboard;
    private readonly EventConfigurationModel model = new();
    private readonly EmailSenderSettingsModel emailModel = new();
    private EmailSenderSettings? emailSettings;
    private string? error;
    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task SaveAsync()
    {
        try { await OrganizerService.SaveEventConfigurationAsync(model.ToInput(), dashboard!.Configuration?.Version); error = null; await RefreshAsync(); }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or StaleDataException) { error = exception.Message; }
    }
    private async Task SaveEmailSettingsAsync()
    {
        try { await EmailCampaignService.SaveSenderSettingsAsync(new EmailSenderSettingsInput(emailModel.FromAddress, emailModel.ReplyToAddress, emailModel.DailySendCeiling, emailModel.IsDomainVerified), emailSettings?.Version); error = null; await RefreshAsync(); }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or StaleDataException) { error = exception.Message; }
    }
    private async Task RefreshAsync() { dashboard = await OrganizerService.GetDashboardAsync(); model.Load(dashboard.Configuration); emailSettings = await EmailCampaignService.GetSenderSettingsAsync(); emailModel.Load(emailSettings); }
    private sealed class EventConfigurationModel
    {
        public int Capacity { get; set; } = 340; public string EventName { get; set; } = string.Empty; public DateTime DoorsLocal { get; set; } = DateTime.Today.AddHours(18); public DateTime StartsLocal { get; set; } = DateTime.Today.AddHours(19); public string VenueName { get; set; } = string.Empty; public string VenueAddress { get; set; } = string.Empty; public string? DressCode { get; set; } public string TimeZoneId { get; set; } = "Europe/Prague"; public string? SupportEmail { get; set; } public int AccessibilityTextLimit { get; set; } = 500;
        public EventConfigurationInput ToInput() => new(Capacity, EventName, DoorsLocal, StartsLocal, VenueName, VenueAddress, DressCode, TimeZoneId, SupportEmail, AccessibilityTextLimit);
        public void Load(EventConfiguration? configuration)
        {
            if (configuration is null) return; Capacity = configuration.Capacity; EventName = configuration.EventName; var zone = TimeZoneInfo.FindSystemTimeZoneById(configuration.TimeZoneId); if (configuration.DoorsAtUtc != default) DoorsLocal = TimeZoneInfo.ConvertTime(configuration.DoorsAtUtc, zone).DateTime; if (configuration.StartsAtUtc != default) StartsLocal = TimeZoneInfo.ConvertTime(configuration.StartsAtUtc, zone).DateTime; VenueName = configuration.VenueName; VenueAddress = configuration.VenueAddress; DressCode = configuration.DressCode; TimeZoneId = configuration.TimeZoneId; SupportEmail = configuration.SupportEmail; AccessibilityTextLimit = configuration.AccessibilityTextLimit;
        }
    }
    private sealed class EmailSenderSettingsModel
    {
        [Required, EmailAddress] public string FromAddress { get; set; } = string.Empty;
        [Required, EmailAddress] public string ReplyToAddress { get; set; } = string.Empty;
        [Range(1, int.MaxValue)] public int DailySendCeiling { get; set; } = 100;
        public bool IsDomainVerified { get; set; }
        public void Load(EmailSenderSettings? settings) { if (settings is null) return; FromAddress = settings.FromAddress; ReplyToAddress = settings.ReplyToAddress; DailySendCeiling = settings.DailySendCeiling; IsDomainVerified = settings.IsDomainVerified; }
    }
}
